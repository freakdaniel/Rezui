<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Design.PreviewWith>
    <Border Padding="24">
      <StackPanel Spacing="12">
        <Button Classes="primary" Content="Основная кнопка" />
        <TextBox PlaceholderText="Поле ввода" />
      </StackPanel>
    </Border>
  </Design.PreviewWith>

  <Style Selector="Window">
    <Setter Property="Background" Value="#0D0F14" />
    <Setter Property="FontFamily" Value="avares://Avalonia.Fonts.Inter/Assets#Inter" />
    <Setter Property="Foreground" Value="#F3F4F8" />
  </Style>

  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="32" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="LineHeight" Value="38" />
  </Style>

  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="#9A9EAA" />
  </Style>

  <Style Selector="Button">
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="16,10" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="#E83E62" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#F05272" />
  </Style>

  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="#191C24" />
    <Setter Property="BorderBrush" Value="#2A2E39" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Button.nav">
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="14,11" />
  </Style>

  <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#1D2029" />
  </Style>

  <Style Selector="TextBox, ComboBox">
    <Setter Property="Background" Value="#171920" />
    <Setter Property="BorderBrush" Value="#2C303B" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="MinHeight" Value="42" />
  </Style>

  <Style Selector="Border.card">
    <Setter Property="Background" Value="#151820" />
    <Setter Property="BorderBrush" Value="#242833" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="14" />
  </Style>

  <Style Selector="Border.dialog">
    <Setter Property="Background" Value="#151820" />
    <Setter Property="BorderBrush" Value="#303542" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="18" />
    <Setter Property="BoxShadow" Value="0 24 60 0 #99000000" />
  </Style>
</Styles>
