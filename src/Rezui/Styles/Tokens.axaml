<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <FontFamily x:Key="Font.Body">avares://Rezui/Assets/Fonts#Google Sans</FontFamily>
  <FontFamily x:Key="Font.Symbols.Rounded">avares://Rezui/Assets/Fonts#Material Symbols Rounded Rezui</FontFamily>
  <FontFamily x:Key="Font.Symbols.Rounded.Filled">avares://Rezui/Assets/Fonts#Material Symbols Rounded Filled Rezui</FontFamily>

  <x:Double x:Key="Space.1">4</x:Double>
  <x:Double x:Key="Space.2">8</x:Double>
  <x:Double x:Key="Space.3">12</x:Double>
  <x:Double x:Key="Space.4">16</x:Double>
  <x:Double x:Key="Space.5">20</x:Double>
  <x:Double x:Key="Space.6">24</x:Double>
  <x:Double x:Key="Space.8">32</x:Double>

  <CornerRadius x:Key="Radius.Control">12</CornerRadius>
  <CornerRadius x:Key="Radius.Card">18</CornerRadius>
  <CornerRadius x:Key="Radius.Island">22</CornerRadius>
  <CornerRadius x:Key="Radius.Pill">999</CornerRadius>

  <Thickness x:Key="Inset.Control">16,10</Thickness>
  <Thickness x:Key="Inset.Card">22</Thickness>

  <Color x:Key="Color.Brand">#FFEF4166</Color>
  <Color x:Key="Color.Brand.Hover">#FFFF5979</Color>
  <Color x:Key="Color.Brand.Soft">#26EF4166</Color>
  <Color x:Key="Color.Success">#FF55C98A</Color>
  <Color x:Key="Color.Warning">#FFFFC857</Color>
  <Color x:Key="Color.Danger">#FFFF6482</Color>

  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <Color x:Key="Color.App.Background">#FFF3F3F4</Color>
      <Color x:Key="Color.Surface.Primary">#FFFCFCFD</Color>
      <Color x:Key="Color.Surface.Secondary">#FFECECEF</Color>
      <Color x:Key="Color.Surface.Elevated">#FFFFFFFF</Color>
      <Color x:Key="Color.Surface.Hero">#FFF2E8EB</Color>
      <Color x:Key="Color.Border.Subtle">#1F18181B</Color>
      <Color x:Key="Color.Border.Strong">#333F3F46</Color>
      <Color x:Key="Color.Text.Primary">#FF1C1C1F</Color>
      <Color x:Key="Color.Text.Secondary">#FF6F6F75</Color>
      <Color x:Key="Color.Text.OnBrand">#FFFFFFFF</Color>
      <Color x:Key="Color.Action.Contrast">#FF1C1C1F</Color>
      <Color x:Key="Color.Action.Contrast.Hover">#FF303034</Color>
      <Color x:Key="Color.Action.Contrast.Pressed">#FF444449</Color>
      <Color x:Key="Color.Action.Contrast.Border">#FF1C1C1F</Color>
      <Color x:Key="Color.Text.OnContrast">#FFFFFFFF</Color>
      <SolidColorBrush x:Key="Brush.Action.Contrast" Color="{StaticResource Color.Action.Contrast}" />
      <SolidColorBrush x:Key="Brush.Action.Contrast.Hover" Color="{StaticResource Color.Action.Contrast.Hover}" />
      <SolidColorBrush x:Key="Brush.Action.Contrast.Pressed" Color="{StaticResource Color.Action.Contrast.Pressed}" />
      <SolidColorBrush x:Key="Brush.Action.Contrast.Border" Color="{StaticResource Color.Action.Contrast.Border}" />
      <SolidColorBrush x:Key="Brush.Text.OnContrast" Color="{StaticResource Color.Text.OnContrast}" />
      <Color x:Key="Color.Scrim">#99101011</Color>
      <Color x:Key="Color.Player.Chrome">#FF171719</Color>
      <Color x:Key="Color.TopMask.Tint">#38F3F3F4</Color>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <Color x:Key="Color.App.Background">#FF0D0D0E</Color>
      <Color x:Key="Color.Surface.Primary">#FF151516</Color>
      <Color x:Key="Color.Surface.Secondary">#FF1C1C1E</Color>
      <Color x:Key="Color.Surface.Elevated">#FF242426</Color>
      <Color x:Key="Color.Surface.Hero">#FF21191C</Color>
      <Color x:Key="Color.Border.Subtle">#26FFFFFF</Color>
      <Color x:Key="Color.Border.Strong">#40FFFFFF</Color>
      <Color x:Key="Color.Text.Primary">#FFF4F4F5</Color>
      <Color x:Key="Color.Text.Secondary">#FFA3A3A8</Color>
      <Color x:Key="Color.Text.OnBrand">#FFFFFFFF</Color>
      <Color x:Key="Color.Action.Contrast">#FFFFFFFF</Color>
      <Color x:Key="Color.Action.Contrast.Hover">#FFF0F0F0</Color>
      <Color x:Key="Color.Action.Contrast.Pressed">#FFE4E4E4</Color>
      <Color x:Key="Color.Action.Contrast.Border">#24000000</Color>
      <Color x:Key="Color.Text.OnContrast">#FF000000</Color>
      <SolidColorBrush x:Key="Brush.Action.Contrast" Color="{StaticResource Color.Action.Contrast}" />
      <SolidColorBrush x:Key="Brush.Action.Contrast.Hover" Color="{StaticResource Color.Action.Contrast.Hover}" />
      <SolidColorBrush x:Key="Brush.Action.Contrast.Pressed" Color="{StaticResource Color.Action.Contrast.Pressed}" />
      <SolidColorBrush x:Key="Brush.Action.Contrast.Border" Color="{StaticResource Color.Action.Contrast.Border}" />
      <SolidColorBrush x:Key="Brush.Text.OnContrast" Color="{StaticResource Color.Text.OnContrast}" />
      <Color x:Key="Color.Scrim">#CC080809</Color>
      <Color x:Key="Color.Player.Chrome">#FF101011</Color>
      <Color x:Key="Color.TopMask.Tint">#460D0D0E</Color>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <SolidColorBrush x:Key="Brush.App.Background" Color="{DynamicResource Color.App.Background}" />
  <SolidColorBrush x:Key="Brush.Surface.Primary" Color="{DynamicResource Color.Surface.Primary}" />
  <SolidColorBrush x:Key="Brush.Surface.Secondary" Color="{DynamicResource Color.Surface.Secondary}" />
  <SolidColorBrush x:Key="Brush.Surface.Elevated" Color="{DynamicResource Color.Surface.Elevated}" />
  <SolidColorBrush x:Key="Brush.Surface.Hero" Color="{DynamicResource Color.Surface.Hero}" />
  <SolidColorBrush x:Key="Brush.Border.Subtle" Color="{DynamicResource Color.Border.Subtle}" />
  <SolidColorBrush x:Key="Brush.Border.Strong" Color="{DynamicResource Color.Border.Strong}" />
  <SolidColorBrush x:Key="Brush.Text.Primary" Color="{DynamicResource Color.Text.Primary}" />
  <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{DynamicResource Color.Text.Secondary}" />
  <SolidColorBrush x:Key="Brush.Text.OnBrand" Color="{DynamicResource Color.Text.OnBrand}" />
  <SolidColorBrush x:Key="Brush.Brand" Color="{StaticResource Color.Brand}" />
  <SolidColorBrush x:Key="Brush.Brand.Hover" Color="{StaticResource Color.Brand.Hover}" />
  <SolidColorBrush x:Key="Brush.Brand.Soft" Color="{StaticResource Color.Brand.Soft}" />
  <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
  <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
  <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
  <SolidColorBrush x:Key="Brush.Scrim" Color="{DynamicResource Color.Scrim}" />
  <SolidColorBrush x:Key="Brush.Player.Chrome" Color="{DynamicResource Color.Player.Chrome}" />
  <SolidColorBrush x:Key="Brush.TopMask.Tint" Color="{DynamicResource Color.TopMask.Tint}" />
</ResourceDictionary>
