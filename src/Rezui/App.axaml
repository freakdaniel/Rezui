<Application
    x:Class="Rezui.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:layout="clr-namespace:Avalonia.Layout;assembly=Avalonia.Controls.ItemsRepeater"
    xmlns:models="clr-namespace:Rezui.Models"
    xmlns:vm="clr-namespace:Rezui.ViewModels"
    xmlns:vlc="clr-namespace:LibVLCSharp.Avalonia;assembly=LibVLCSharp.Avalonia"
    xmlns:vlcShared="clr-namespace:LibVLCSharp.Shared;assembly=LibVLCSharp"
    RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Rezui/Styles/Tokens.axaml" />
        <ResourceInclude Source="avares://Rezui/Styles/SharedTemplates.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <!--
    Type-keyed DataTemplates formerly registered on Window.DataTemplates.
    Hosting them at application scope lets every page UserControl resolve its
    ContentControl content (library folders, the video player surface and the
    category mega-menu) without per-page registration. Commands resolve the
    view-model through $parent[Window] so the templates remain portable.
  -->
  <Application.DataTemplates>
    <DataTemplate DataType="models:LibraryFolderItem">
      <StackPanel Margin="0,0,0,26" Spacing="14">
        <StackPanel Orientation="Horizontal" Spacing="9">
          <TextBlock Classes="h2" Text="{Binding Name}" />
          <Border
              Padding="8,3"
              VerticalAlignment="Center"
              Background="{DynamicResource Brush.Surface.Secondary}"
              CornerRadius="999">
            <TextBlock
                Classes="muted"
                FontSize="11"
                Text="{Binding ItemCount}" />
          </Border>
        </StackPanel>
        <ItemsRepeater
            ClipToBounds="False"
            HorizontalCacheLength="1"
            ItemTemplate="{StaticResource MediaCardTemplate}"
            ItemsSource="{Binding Items}"
            VerticalCacheLength="1">
          <ItemsRepeater.Layout>
            <layout:UniformGridLayout
                ItemsJustification="Start"
                MinItemHeight="320"
                MinItemWidth="190" />
          </ItemsRepeater.Layout>
        </ItemsRepeater>
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="vlcShared:MediaPlayer">
      <vlc:VideoView MediaPlayer="{Binding}" />
    </DataTemplate>

    <DataTemplate DataType="models:CategoryMenuDefinition">
      <Grid Margin="18" RowDefinitions="Auto,Auto" RowSpacing="14">
        <Border Padding="12" Classes="mega-menu-header">
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <StackPanel VerticalAlignment="Center" Spacing="2">
              <TextBlock
                  FontSize="17"
                  FontWeight="SemiBold"
                  Text="{Binding Title}" />
              <TextBlock
                  Classes="muted"
                  FontSize="11"
                  Text="Жанры и направления" />
            </StackPanel>
            <Button
                Grid.Column="1"
                Classes="mega-menu-action"
                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).BrowseCategoryCommand}"
                CommandParameter="{Binding NewDescriptor}"
                Content="Новинки" />
            <Button
                Grid.Column="2"
                Classes="mega-menu-action contrast"
                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).BrowseCategoryCommand}"
                CommandParameter="{Binding AllDescriptor}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Text="{Binding AllLabel}"
                    TextAlignment="Center" />
                <TextBlock
                    Classes="symbol mega-menu-action-arrow"
                    FontSize="16"
                    Text="arrow_forward" />
              </StackPanel>
            </Button>
          </Grid>
        </Border>

        <ItemsControl Grid.Row="1" ItemsSource="{Binding Columns}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="4" ColumnSpacing="8" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:CategoryMenuColumn">
              <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:CategoryMenuItem">
                    <Button
                        Classes="mega-menu-item"
                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).BrowseCategoryCommand}"
                        CommandParameter="{Binding Descriptor}"
                        Content="{Binding Title}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </DataTemplate>
  </Application.DataTemplates>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Rezui/Styles/Theme.axaml" />
  </Application.Styles>
</Application>
