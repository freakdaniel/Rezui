<UserControl
    x:Class="Rezui.Views.PlayerPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="clr-namespace:Rezui.Models"
    xmlns:vm="clr-namespace:Rezui.ViewModels"
    x:DataType="vm:MainWindowViewModel">

  <!--
    Player page. The video surface, chrome bars and transport controls.
    Fullscreen toggling and seek-on-release are handled here because they need
    access to the host window and the view-model's Player; the host window is
    reached through the visual tree (GetSelfAndVisualAncestors).
  -->
  <Grid
      IsVisible="{Binding IsPlayerVisible}"
      RowDefinitions="Auto,*,Auto">
    <Border Padding="24,14" Background="{DynamicResource Brush.Player.Chrome}">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <Button Classes="ghost" Command="{Binding BackFromPlayerCommand}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Classes="symbol" Text="arrow_back" />
            <TextBlock Text="Назад" />
          </StackPanel>
        </Button>
        <StackPanel Grid.Column="1" Margin="18,0" VerticalAlignment="Center">
          <TextBlock Foreground="White" FontWeight="SemiBold" Text="{Binding Player.Title}" />
          <TextBlock Foreground="#B8B8BC" FontSize="11" Text="{Binding Player.StatusText}" />
        </StackPanel>
        <Button Grid.Column="2" Classes="icon-button" Click="FullscreenButton_OnClick">
          <TextBlock Classes="symbol" Text="fullscreen" />
        </Button>
      </Grid>
    </Border>
    <Border Grid.Row="1" Background="Black">
      <!-- MediaPlayer resolves its template from the app-level DataTemplate
           in SharedTemplates.axaml (DataType=vlcShared:MediaPlayer). -->
      <ContentControl Content="{Binding Player.MediaPlayer}" />
    </Border>
    <Border Grid.Row="2" Padding="24,14" Background="{DynamicResource Brush.Player.Chrome}">
      <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
        <Grid ColumnDefinitions="2*,*,*,*,*,Auto" ColumnSpacing="10">
          <StackPanel Spacing="4">
            <TextBlock Classes="player-field-label" Text="Озвучка" />
            <ComboBox
                Classes="player-select"
                ItemsSource="{Binding Translations}"
                SelectedItem="{Binding SelectedTranslation}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="models:TranslationItem">
                  <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <StackPanel Grid.Column="1" IsVisible="{Binding IsSeries}" Spacing="4">
            <TextBlock Classes="player-field-label" Text="Сезон" />
            <ComboBox
                Classes="player-select"
                ItemsSource="{Binding Seasons}"
                SelectedItem="{Binding SelectedSeason}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="models:ChoiceItem">
                  <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <StackPanel Grid.Column="2" IsVisible="{Binding IsSeries}" Spacing="4">
            <TextBlock Classes="player-field-label" Text="Серия" />
            <ComboBox
                Classes="player-select"
                ItemsSource="{Binding Episodes}"
                SelectedItem="{Binding SelectedEpisode}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="models:ChoiceItem">
                  <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <StackPanel Grid.Column="3" Spacing="4">
            <TextBlock Classes="player-field-label" Text="Качество" />
            <ComboBox
                Classes="player-select"
                ItemsSource="{Binding Qualities}"
                SelectedItem="{Binding SelectedQuality}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="models:QualityItem">
                  <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <StackPanel Grid.Column="4" Spacing="4">
            <TextBlock Classes="player-field-label" Text="Субтитры" />
            <ComboBox
                Classes="player-select"
                ItemsSource="{Binding Subtitles}"
                SelectedItem="{Binding SelectedSubtitle}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="models:SubtitleItem">
                  <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <Button
              Grid.Column="5"
              Width="44"
              Height="44"
              Margin="0,18,0,0"
              Padding="0"
              Classes="player-apply"
              Command="{Binding ApplyPlaybackSelectionCommand}">
            <TextBlock Classes="symbol filled" FontSize="22" Text="play_arrow" />
          </Button>
        </Grid>
        <Slider
            Grid.Row="1"
            Maximum="{Binding Player.DurationMs}"
            Minimum="0"
            PointerReleased="SeekSlider_OnPointerReleased"
            Value="{Binding Player.CurrentTimeMs, Mode=OneWay}" />
        <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,Auto,*,Auto,160">
          <Button
              Padding="12,7"
              Classes="ghost"
              Command="{Binding Player.SkipBackCommand}">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock Classes="symbol" Text="replay_10" />
              <TextBlock Text="10" />
            </StackPanel>
          </Button>
          <Button
              Grid.Column="1"
              Margin="8,0"
              Padding="18,7"
              Classes="primary"
              Command="{Binding Player.TogglePlaybackCommand}">
            <TextBlock Classes="symbol filled" Text="play_pause" />
          </Button>
          <Button
              Grid.Column="2"
              Padding="12,7"
              Classes="ghost"
              Command="{Binding Player.SkipForwardCommand}">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock Classes="symbol" Text="forward_10" />
              <TextBlock Text="10" />
            </StackPanel>
          </Button>
          <TextBlock
              Grid.Column="4"
              Margin="16,0"
              VerticalAlignment="Center"
              Foreground="#B8B8BC">
            <TextBlock.Inlines>
              <Run Text="{Binding Player.CurrentTimeText}" />
              <Run Text=" / " />
              <Run Text="{Binding Player.DurationText}" />
            </TextBlock.Inlines>
          </TextBlock>
          <Slider
              Grid.Column="5"
              Maximum="100"
              Minimum="0"
              Value="{Binding Player.Volume}" />
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
