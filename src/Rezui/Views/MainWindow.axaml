<Window
    x:Name="RootWindow"
    x:Class="Rezui.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:Rezui.Views"
    xmlns:vm="clr-namespace:Rezui.ViewModels"
    x:DataType="vm:MainWindowViewModel"
    mc:Ignorable="d"
    Width="1320"
    Height="840"
    MinWidth="1000"
    MinHeight="700"
    Title="Rezui">

  <!--
    Thin shell. All page markup now lives under Views/Pages as UserControl
    layers; the window hosts them and keeps only the cross-page chrome: the
    top navigation island, the category/profile popups, the startup overlay
    and the non-blocking busy indicator. Each page inherits the window's
    DataContext (MainWindowViewModel) and uses compiled bindings.
  -->
  <Window.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding CloseProfilePopupCommand}" />
  </Window.KeyBindings>

  <Grid>
    <!-- Main application shell -->
    <Grid IsVisible="{Binding IsShellVisible}">
      <Border
          ZIndex="10"
          Width="{Binding Bounds.Width, ElementName=TopIsland}"
          Height="{Binding Bounds.Height, ElementName=TopIsland}"
          Margin="28,22,28,0"
          HorizontalAlignment="Center"
          VerticalAlignment="Top"
          IsHitTestVisible="False"
          IsVisible="{Binding !IsPlayerVisible}"
          Classes="top-island-shadow" />
      <Border
          x:Name="TopIsland"
          ZIndex="20"
          MaxWidth="1120"
          Margin="28,22,28,0"
          Padding="7"
          HorizontalAlignment="Center"
          VerticalAlignment="Top"
          IsVisible="{Binding !IsPlayerVisible}"
          Classes="island top-island">
        <Grid ColumnDefinitions="Auto,12,Auto,Auto,Auto,Auto,Auto,12,Auto">
          <Image
              Width="34"
              Height="34"
              RenderOptions.BitmapInterpolationMode="HighQuality"
              Source="avares://Rezui/Assets/rezui.png"
              Stretch="Uniform" />

          <Button
              Grid.Column="2"
              Classes="nav"
              Classes.active="{Binding IsHomeVisible}"
              Command="{Binding ShowHomeCommand}">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock
                  Classes="symbol"
                  Classes.filled="{Binding IsHomeVisible}"
                  FontSize="16"
                  Text="home" />
              <TextBlock VerticalAlignment="Center" Text="Главная" />
            </StackPanel>
          </Button>
          <Button
              x:Name="FilmsNavButton"
              Grid.Column="3"
              Classes="nav category"
              Classes.active="{Binding IsFilmsCategory}"
              Classes.menu-open="{Binding IsFilmsMenuOpen}"
              Command="{Binding ToggleCategoryMenuCommand}"
              CommandParameter="{Binding FilmsMenu}">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock
                  Classes="symbol"
                  Classes.filled="{Binding IsFilmsCategory}"
                  FontSize="16"
                  Text="movie" />
              <TextBlock VerticalAlignment="Center" Text="Фильмы" />
              <TextBlock Classes="symbol chevron" FontSize="16" Text="expand_more" />
            </StackPanel>
          </Button>
          <Button
              x:Name="SeriesNavButton"
              Grid.Column="4"
              Classes="nav category"
              Classes.active="{Binding IsSeriesCategory}"
              Classes.menu-open="{Binding IsSeriesMenuOpen}"
              Command="{Binding ToggleCategoryMenuCommand}"
              CommandParameter="{Binding SeriesMenu}">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock
                  Classes="symbol"
                  Classes.filled="{Binding IsSeriesCategory}"
                  FontSize="16"
                  Text="tv" />
              <TextBlock VerticalAlignment="Center" Text="Сериалы" />
              <TextBlock Classes="symbol chevron" FontSize="16" Text="expand_more" />
            </StackPanel>
          </Button>
          <Button
              x:Name="CartoonsNavButton"
              Grid.Column="5"
              Classes="nav category"
              Classes.active="{Binding IsCartoonsCategory}"
              Classes.menu-open="{Binding IsCartoonsMenuOpen}"
              Command="{Binding ToggleCategoryMenuCommand}"
              CommandParameter="{Binding CartoonsMenu}">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock
                  Classes="symbol"
                  Classes.filled="{Binding IsCartoonsCategory}"
                  FontSize="16"
                  Text="palette" />
              <TextBlock VerticalAlignment="Center" Text="Мультфильмы" />
              <TextBlock Classes="symbol chevron" FontSize="16" Text="expand_more" />
            </StackPanel>
          </Button>
          <Button
              x:Name="AnimeNavButton"
              Grid.Column="6"
              Classes="nav category"
              Classes.active="{Binding IsAnimeCategory}"
              Classes.menu-open="{Binding IsAnimeMenuOpen}"
              Command="{Binding ToggleCategoryMenuCommand}"
              CommandParameter="{Binding AnimeMenu}">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock
                  Classes="symbol"
                  Classes.filled="{Binding IsAnimeCategory}"
                  FontSize="16"
                  Text="auto_awesome" />
              <TextBlock VerticalAlignment="Center" Text="Аниме" />
              <TextBlock Classes="symbol chevron" FontSize="16" Text="expand_more" />
            </StackPanel>
          </Button>

          <Button
              x:Name="ProfileAvatarButton"
              Grid.Column="8"
              Classes="profile-avatar"
              Command="{Binding ToggleProfilePopupCommand}"
              AutomationProperties.Name="Открыть меню профиля">
            <Border
                Width="34"
                Height="34"
                Background="{DynamicResource Brush.TopBar.Accent.Soft}"
                Classes="profile-avatar-image"
                CornerRadius="17"
                ClipToBounds="True">
              <Grid>
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource Brush.TopBar.Accent}"
                    FontSize="12"
                    FontWeight="Bold"
                    Text="{Binding ProfileInitials}" />
                <Image Source="{Binding ProfileImageSource^}" Stretch="UniformToFill" />
              </Grid>
            </Border>
          </Button>
        </Grid>
      </Border>

      <Grid
          ZIndex="0"
          Background="{DynamicResource Brush.App.Background}">
        <!-- Page layers. Each page binds its own visibility to the view-model
             so only the active one is ever measured/rendered. -->
        <views:HomePage />
        <views:LibraryPage />
        <views:SettingsPage />
        <views:DetailsPage />
        <views:PlayerPage />
      </Grid>

      <!-- Large in-app category popup, positioned independently of its trigger. -->
      <Grid
          ZIndex="15"
          ClipToBounds="False"
          IsHitTestVisible="{Binding IsCategoryMenuOpen}"
          IsVisible="{Binding !IsPlayerVisible}">
        <Button
            Classes="popup-dismiss"
            Command="{Binding CloseCategoryMenuCommand}"
            AutomationProperties.Name="Закрыть меню категорий" />
        <Grid ColumnDefinitions="24,*,24" ClipToBounds="False">
          <Border
              x:Name="CategoryMenuPopup"
              Grid.Column="1"
              ZIndex="1"
              MaxWidth="1000"
              Margin="0,90,0,24"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Top"
              Classes="category-mega-menu category-menu-popup"
              Classes.open="{Binding IsCategoryMenuOpen}"
              ClipToBounds="False"
              IsHitTestVisible="{Binding IsCategoryMenuOpen}">
            <!-- OpenCategoryMenu resolves its template from the app-level
                 CategoryMenuDefinition DataTemplate in SharedTemplates.axaml. -->
            <ContentControl
                HorizontalContentAlignment="Stretch"
                Content="{Binding OpenCategoryMenu}" />
          </Border>
        </Grid>
      </Grid>

      <!-- In-app profile overlay keeps both opening and closing animations in the visual tree -->
      <Grid
          ZIndex="30"
          IsHitTestVisible="{Binding IsProfilePopupOpen}"
          IsVisible="{Binding !IsPlayerVisible}">
        <Button
            Classes="popup-dismiss"
            Command="{Binding CloseProfilePopupCommand}"
            AutomationProperties.Name="Закрыть меню профиля" />
        <Grid
            Width="{Binding Bounds.Width, ElementName=TopIsland}"
            HorizontalAlignment="Center">
          <Grid
              Width="38"
              Margin="0,0,7,0"
              HorizontalAlignment="Right">
            <Border
                x:Name="ProfilePopup"
                ZIndex="1"
                Width="220"
                Margin="0,92,0,0"
                Padding="8"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Classes="profile-popup"
                Classes.open="{Binding IsProfilePopupOpen}"
                IsHitTestVisible="{Binding IsProfilePopupOpen}">
              <StackPanel Spacing="7">
                <Border Padding="8" Classes="profile-header-card">
                  <StackPanel
                      HorizontalAlignment="Center"
                      Orientation="Horizontal"
                      Spacing="8">
                    <Border
                        Width="34"
                        Height="34"
                        Background="{DynamicResource Brush.TopBar.Accent.Soft}"
                        CornerRadius="17"
                        ClipToBounds="True">
                      <Grid>
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource Brush.TopBar.Accent}"
                            FontSize="11"
                            FontWeight="Bold"
                            Text="{Binding ProfileInitials}" />
                        <Image Source="{Binding ProfileImageSource^}" Stretch="UniformToFill" />
                      </Grid>
                    </Border>
                    <StackPanel
                        MaxWidth="150"
                        VerticalAlignment="Center"
                        Spacing="1">
                      <TextBlock
                          FontFamily="{StaticResource Font.Body}"
                          FontSize="13"
                          FontWeight="SemiBold"
                          Foreground="{DynamicResource Brush.Text.Primary}"
                          Text="{Binding ProfileName}"
                          TextTrimming="CharacterEllipsis" />
                      <TextBlock
                          Classes="muted"
                          FontFamily="{StaticResource Font.Body}"
                          FontSize="10"
                          Text="{Binding ProfileEmail}"
                          TextTrimming="CharacterEllipsis" />
                      <TextBlock
                          IsVisible="{Binding IsPremium}"
                          Foreground="{DynamicResource Brush.TopBar.Accent}"
                          FontSize="10"
                          FontWeight="SemiBold"
                          Text="Premium" />
                    </StackPanel>
                  </StackPanel>
                </Border>

                <StackPanel Spacing="3">
                  <Button
                      Classes="popup-nav"
                      Classes.active="{Binding IsLibraryVisible}"
                      Command="{Binding ShowLibraryCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock
                          Classes="symbol"
                          Classes.filled="{Binding IsLibraryVisible}"
                          FontSize="17"
                          Text="video_library" />
                      <TextBlock VerticalAlignment="Center" Text="Библиотека" />
                    </StackPanel>
                  </Button>
                  <Button
                      Classes="popup-nav"
                      Classes.active="{Binding IsSettingsVisible}"
                      Command="{Binding OpenSettingsCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock
                          Classes="symbol"
                          Classes.filled="{Binding IsSettingsVisible}"
                          FontSize="17"
                          Text="settings" />
                      <TextBlock VerticalAlignment="Center" Text="Настройки" />
                    </StackPanel>
                  </Button>
                  <Button
                      Classes="popup-nav logout"
                      Command="{Binding LogoutCommand}"
                      AutomationProperties.Name="Выйти из аккаунта">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Classes="symbol" FontSize="17" Text="logout" />
                      <TextBlock VerticalAlignment="Center" Text="Выйти" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </StackPanel>
            </Border>
          </Grid>
        </Grid>
      </Grid>
    </Grid>

    <!-- Startup and mandatory authentication -->
    <views:StartupView />

    <!-- Non-blocking operation status -->
    <Border
        Margin="0,0,24,24"
        Padding="16,12"
        HorizontalAlignment="Right"
        VerticalAlignment="Bottom"
        Classes="island"
        IsVisible="{Binding IsBusy}">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <ProgressBar
            Width="90"
            VerticalAlignment="Center"
            IsIndeterminate="True" />
        <TextBlock
            MaxWidth="320"
            VerticalAlignment="Center"
            Text="{Binding StatusMessage}"
            TextTrimming="CharacterEllipsis" />
        <Button
            Padding="9,5"
            Command="{Binding CancelOperationCommand}"
            Content="Отмена" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
