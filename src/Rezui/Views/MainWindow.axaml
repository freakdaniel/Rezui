<Window
    x:Name="RootWindow"
    x:Class="Rezui.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:layout="clr-namespace:Avalonia.Layout;assembly=Avalonia.Controls.ItemsRepeater"
    xmlns:models="clr-namespace:Rezui.Models"
    xmlns:transitions="clr-namespace:Rezui.Transitions"
    xmlns:vm="clr-namespace:Rezui.ViewModels"
    xmlns:vlc="clr-namespace:LibVLCSharp.Avalonia;assembly=LibVLCSharp.Avalonia"
    xmlns:vlcShared="clr-namespace:LibVLCSharp.Shared;assembly=LibVLCSharp"
    x:DataType="vm:MainWindowViewModel"
    mc:Ignorable="d"
    Width="1320"
    Height="840"
    MinWidth="1000"
    MinHeight="700"
    Title="Rezui">

  <Window.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding CloseProfilePopupCommand}" />
  </Window.KeyBindings>

  <Window.Resources>
    <DataTemplate x:Key="MediaCardTemplate" x:DataType="models:MediaCardItem">
      <Button
          Width="174"
          Margin="0,0,16,20"
          Classes="media-card"
          Command="{Binding OpenCommand}">
        <StackPanel Spacing="10">
          <Border
              Height="246"
              Background="{DynamicResource Brush.Surface.Secondary}"
              BorderBrush="{DynamicResource Brush.Border.Subtle}"
              BorderThickness="1"
              CornerRadius="16"
              ClipToBounds="True">
            <Grid>
              <TextBlock
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Classes="symbol"
                  Foreground="{DynamicResource Brush.Text.Secondary}"
                  Text="movie" />
              <Image Source="{Binding ImageSource.Value^}" Stretch="UniformToFill" />
              <Border
                  Padding="9,5"
                  Margin="10"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Bottom"
                  Background="#CC111014"
                  CornerRadius="8">
                <TextBlock
                    Foreground="White"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Text="{Binding Category}" />
              </Border>
            </Grid>
          </Border>
          <TextBlock
              MaxHeight="44"
              FontSize="14"
              FontWeight="SemiBold"
              Text="{Binding Title}"
              TextTrimming="CharacterEllipsis"
              TextWrapping="Wrap" />
        </StackPanel>
      </Button>
    </DataTemplate>
    <DataTemplate x:Key="CommentNodeTemplate" x:DataType="models:CommentNodeItem">
      <Grid ColumnDefinitions="38,*" RowDefinitions="Auto,Auto,Auto">
        <!-- Avatar column. A two-row inner grid keeps the thread anchored to the
             fixed 38px avatar (constant ~5px gap under it) rather than to the
             taller content column. The thread spans rows 1-2 so it reaches the
             toggle row where the elbow continues it; its bottom margin stops it
             just above the elbow so they join without overlap. -->
        <Grid Grid.Row="0" Grid.RowSpan="3" Grid.Column="0" RowDefinitions="38,*">
          <Border
              Grid.Row="0"
              Width="38"
              Height="38"
              CornerRadius="19"
              ClipToBounds="True"
              Background="{DynamicResource Brush.Surface.Secondary}">
            <Image Source="{Binding AvatarSource.Value^}" Stretch="UniformToFill" />
          </Border>
          <Border
              Grid.Row="1"
              Width="2"
              Margin="0,5,0,30"
              HorizontalAlignment="Center"
              VerticalAlignment="Stretch"
              Background="{DynamicResource Brush.Border.Subtle}"
              IsVisible="{Binding HasReplies}" />
        </Grid>

        <!-- Comment content (row 0). -->
        <StackPanel Grid.Row="0" Grid.Column="1" Margin="10,0,0,0" Spacing="5" VerticalAlignment="Top">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding Author}" />
            <TextBlock Grid.Column="1" Classes="muted" FontSize="10" Text="{Binding DateLabel}" />
          </Grid>
          <TextBlock FontSize="12" LineHeight="18" Text="{Binding Text}" TextWrapping="Wrap" />
          <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="5">
            <TextBlock
                VerticalAlignment="Center"
                Classes="symbol"
                FontSize="15"
                LineHeight="16"
                Text="thumb_up" />
            <TextBlock
                VerticalAlignment="Center"
                Classes="muted"
                FontSize="12"
                FontWeight="Medium"
                LineHeight="16"
                Text="{Binding Likes}" />
          </StackPanel>
        </StackPanel>

        <!-- Replies (row 1). -->
        <StackPanel
            Grid.Row="1"
            Grid.Column="1"
            Margin="10,5,0,0"
            Spacing="10"
            IsVisible="{Binding HasReplies}">
          <ItemsControl ItemTemplate="{StaticResource CommentNodeTemplate}" ItemsSource="{Binding RenderedReplies}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="10" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
          <!-- Long threads (>3 replies): overflow replies behind a button -->
          <ItemsControl ItemTemplate="{StaticResource CommentNodeTemplate}" ItemsSource="{Binding OverflowReplies}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="10" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </StackPanel>

        <!-- Elbow + toggle button (row 2). The elbow Path spans both columns so
             its origin aligns with the avatar column; it continues the vertical
             thread (starts at x=19) then curves and runs right toward the
             button with a small gap. StrokeThickness 3 keeps the J as thick as
             the 2px thread visually. Height matches the button so the
             horizontal sits at its vertical center. -->
        <Path
            Grid.Row="2"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Width="38"
            Height="30"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Stretch="None"
            Stroke="{DynamicResource Brush.Border.Subtle}"
            StrokeThickness="3"
            Data="M 19 0 L 19 9 Q 19 15 25 15 L 38 15"
            IsVisible="{Binding HasReplies}" />
        <Button
            Grid.Row="2"
            Grid.Column="1"
            Margin="8,0,0,0"
            VerticalAlignment="Center"
            Classes="comment-toggle"
            Command="{Binding ToggleExpandedCommand}"
            IsVisible="{Binding HasOverflow}"
            ToolTip.Tip="Развернуть или свернуть остальные ответы">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <TextBlock Classes="symbol" FontSize="15" Text="{Binding CollapseIcon}" />
            <TextBlock Text="{Binding OverflowLabel}" />
          </StackPanel>
        </Button>
        <Button
            Grid.Row="2"
            Grid.Column="1"
            Margin="8,0,0,0"
            VerticalAlignment="Center"
            Classes="comment-toggle"
            Command="{Binding ToggleExpandedCommand}"
            IsVisible="{Binding CanToggleBranch}">
          <StackPanel Orientation="Horizontal" Spacing="5">
            <TextBlock Classes="symbol" FontSize="15" Text="{Binding CollapseIcon}" />
            <TextBlock Text="{Binding CollapseLabel}" />
          </StackPanel>
        </Button>
      </Grid>
    </DataTemplate>
  </Window.Resources>

  <Window.DataTemplates>

    <DataTemplate DataType="models:LibraryFolderItem">
      <StackPanel Margin="0,0,0,26" Spacing="14">
        <StackPanel Orientation="Horizontal" Spacing="9">
          <TextBlock Classes="h2" Text="{Binding Name}" />
          <Border
              Padding="8,3"
              VerticalAlignment="Center"
              Background="{DynamicResource Brush.Surface.Secondary}"
              CornerRadius="999">
            <TextBlock
                Classes="muted"
                FontSize="11"
                Text="{Binding ItemCount}" />
          </Border>
        </StackPanel>
        <ItemsRepeater
            ClipToBounds="False"
            HorizontalCacheLength="1"
            ItemTemplate="{StaticResource MediaCardTemplate}"
            ItemsSource="{Binding Items}"
            VerticalCacheLength="1">
          <ItemsRepeater.Layout>
            <layout:UniformGridLayout
                ItemsJustification="Start"
                MinItemHeight="320"
                MinItemWidth="190" />
          </ItemsRepeater.Layout>
        </ItemsRepeater>
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="vlcShared:MediaPlayer">
      <vlc:VideoView MediaPlayer="{Binding}" />
    </DataTemplate>

    <DataTemplate DataType="models:CategoryMenuDefinition">
      <Grid Margin="18" RowDefinitions="Auto,Auto" RowSpacing="14">
        <Border Padding="12" Classes="mega-menu-header">
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <StackPanel VerticalAlignment="Center" Spacing="2">
              <TextBlock
                  FontSize="17"
                  FontWeight="SemiBold"
                  Text="{Binding Title}" />
              <TextBlock
                  Classes="muted"
                  FontSize="11"
                  Text="Жанры и направления" />
            </StackPanel>
            <Button
                Grid.Column="1"
                Classes="mega-menu-action"
                Command="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).BrowseCategoryCommand}"
                CommandParameter="{Binding NewDescriptor}"
                Content="Новинки" />
            <Button
                Grid.Column="2"
                Classes="mega-menu-action contrast"
                Command="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).BrowseCategoryCommand}"
                CommandParameter="{Binding AllDescriptor}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Text="{Binding AllLabel}"
                    TextAlignment="Center" />
                <TextBlock
                    Classes="symbol mega-menu-action-arrow"
                    FontSize="16"
                    Text="arrow_forward" />
              </StackPanel>
            </Button>
          </Grid>
        </Border>

        <ItemsControl Grid.Row="1" ItemsSource="{Binding Columns}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="4" ColumnSpacing="8" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:CategoryMenuColumn">
              <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:CategoryMenuItem">
                    <Button
                        Classes="mega-menu-item"
                        Command="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).BrowseCategoryCommand}"
                        CommandParameter="{Binding Descriptor}"
                        Content="{Binding Title}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </DataTemplate>
  </Window.DataTemplates>

  <Grid>
    <!-- Main application shell -->
    <Grid
        IsVisible="{Binding IsShellVisible}">
      <Border
          ZIndex="10"
          Width="{Binding Bounds.Width, ElementName=TopIsland}"
          Height="{Binding Bounds.Height, ElementName=TopIsland}"
          Margin="28,22,28,0"
          HorizontalAlignment="Center"
          VerticalAlignment="Top"
          IsHitTestVisible="False"
          IsVisible="{Binding !IsPlayerVisible}"
          Classes="top-island-shadow" />
      <Border
          x:Name="TopIsland"
          ZIndex="20"
          MaxWidth="1120"
          Margin="28,22,28,0"
          Padding="7"
          HorizontalAlignment="Center"
          VerticalAlignment="Top"
          IsVisible="{Binding !IsPlayerVisible}"
          Classes="island top-island">
        <Grid ColumnDefinitions="Auto,12,Auto,Auto,Auto,Auto,Auto,12,Auto">
          <Image
              Width="34"
              Height="34"
              RenderOptions.BitmapInterpolationMode="HighQuality"
              Source="avares://Rezui/Assets/rezui.png"
              Stretch="Uniform" />

          <Button
              Grid.Column="2"
              Classes="nav"
              Classes.active="{Binding IsHomeVisible}"
              Command="{Binding ShowHomeCommand}">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock
                  Classes="symbol"
                  Classes.filled="{Binding IsHomeVisible}"
                  FontSize="16"
                  Text="home" />
              <TextBlock VerticalAlignment="Center" Text="Главная" />
            </StackPanel>
          </Button>
          <Button
              x:Name="FilmsNavButton"
              Grid.Column="3"
              Classes="nav category"
              Classes.active="{Binding IsFilmsCategory}"
              Classes.menu-open="{Binding IsFilmsMenuOpen}"
              Command="{Binding ToggleCategoryMenuCommand}"
              CommandParameter="{Binding FilmsMenu}">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock
                  Classes="symbol"
                  Classes.filled="{Binding IsFilmsCategory}"
                  FontSize="16"
                  Text="movie" />
              <TextBlock VerticalAlignment="Center" Text="Фильмы" />
              <TextBlock Classes="symbol chevron" FontSize="16" Text="expand_more" />
            </StackPanel>
          </Button>
          <Button
              x:Name="SeriesNavButton"
              Grid.Column="4"
              Classes="nav category"
              Classes.active="{Binding IsSeriesCategory}"
              Classes.menu-open="{Binding IsSeriesMenuOpen}"
              Command="{Binding ToggleCategoryMenuCommand}"
              CommandParameter="{Binding SeriesMenu}">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock
                  Classes="symbol"
                  Classes.filled="{Binding IsSeriesCategory}"
                  FontSize="16"
                  Text="tv" />
              <TextBlock VerticalAlignment="Center" Text="Сериалы" />
              <TextBlock Classes="symbol chevron" FontSize="16" Text="expand_more" />
            </StackPanel>
          </Button>
          <Button
              x:Name="CartoonsNavButton"
              Grid.Column="5"
              Classes="nav category"
              Classes.active="{Binding IsCartoonsCategory}"
              Classes.menu-open="{Binding IsCartoonsMenuOpen}"
              Command="{Binding ToggleCategoryMenuCommand}"
              CommandParameter="{Binding CartoonsMenu}">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock
                  Classes="symbol"
                  Classes.filled="{Binding IsCartoonsCategory}"
                  FontSize="16"
                  Text="palette" />
              <TextBlock VerticalAlignment="Center" Text="Мультфильмы" />
              <TextBlock Classes="symbol chevron" FontSize="16" Text="expand_more" />
            </StackPanel>
          </Button>
          <Button
              x:Name="AnimeNavButton"
              Grid.Column="6"
              Classes="nav category"
              Classes.active="{Binding IsAnimeCategory}"
              Classes.menu-open="{Binding IsAnimeMenuOpen}"
              Command="{Binding ToggleCategoryMenuCommand}"
              CommandParameter="{Binding AnimeMenu}">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock
                  Classes="symbol"
                  Classes.filled="{Binding IsAnimeCategory}"
                  FontSize="16"
                  Text="auto_awesome" />
              <TextBlock VerticalAlignment="Center" Text="Аниме" />
              <TextBlock Classes="symbol chevron" FontSize="16" Text="expand_more" />
            </StackPanel>
          </Button>

          <Button
              x:Name="ProfileAvatarButton"
              Grid.Column="8"
              Classes="profile-avatar"
              Command="{Binding ToggleProfilePopupCommand}"
              AutomationProperties.Name="Открыть меню профиля">
            <Border
                Width="34"
                Height="34"
                Background="{DynamicResource Brush.TopBar.Accent.Soft}"
                Classes="profile-avatar-image"
                CornerRadius="17"
                ClipToBounds="True">
              <Grid>
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource Brush.TopBar.Accent}"
                    FontSize="12"
                    FontWeight="Bold"
                    Text="{Binding ProfileInitials}" />
                <Image Source="{Binding ProfileImageSource^}" Stretch="UniformToFill" />
              </Grid>
            </Border>
          </Button>
        </Grid>
      </Border>

      <Grid
          ZIndex="0"
          Background="{DynamicResource Brush.App.Background}">
        <!-- Home -->
        <ScrollViewer
            Classes="smooth-scroll home-page"
            Classes.entering="{Binding IsHomeEntering}"
            Classes.leaving="{Binding IsHomeLeaving}"
            IsVisible="{Binding IsHomeVisible}">
          <StackPanel
              MaxWidth="1120"
              Margin="28,126,28,56"
              HorizontalAlignment="Center"
              Classes="home-content"
              Spacing="32">
            <StackPanel.RenderTransform>
              <TransformGroup>
                <ScaleTransform />
                <TranslateTransform />
              </TransformGroup>
            </StackPanel.RenderTransform>
            <Border
                Height="284"
                Background="{DynamicResource Brush.Surface.Hero}"
                Classes="home-hero"
                CornerRadius="24"
                ClipToBounds="True"
                IsVisible="{Binding HasContinueWatchingHero}">
              <Border.RenderTransform>
                <TransformGroup>
                  <ScaleTransform />
                  <TranslateTransform />
                </TransformGroup>
              </Border.RenderTransform>
              <ContentControl
                  FontFamily="{StaticResource Font.Body}"
                  HorizontalContentAlignment="Stretch"
                  VerticalContentAlignment="Stretch"
                  Content="{Binding ContinueWatchingHero}">
                <ContentControl.ContentTemplate>
                  <DataTemplate x:DataType="models:ContinueWatchingHeroItem">
                    <Grid Height="284" ClipToBounds="True">
                      <Image
                          Classes="continue-hero-background"
                          Opacity="0.96"
                          RenderTransformOrigin="50%,50%"
                          Source="{Binding BackgroundImageSource.Value^}"
                          Stretch="UniformToFill">
                        <Image.RenderTransform>
                          <ScaleTransform ScaleX="1.18" ScaleY="1.18" />
                        </Image.RenderTransform>
                        <Image.CacheMode>
                          <BitmapCache RenderAtScale="0.6" />
                        </Image.CacheMode>
                        <Image.Effect>
                          <BlurEffect Radius="46" />
                        </Image.Effect>
                      </Image>
                      <Border Background="#B8111114" />
                      <Border>
                        <Border.Background>
                          <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                            <GradientStop Color="#F2111114" Offset="0" />
                            <GradientStop Color="#D9111114" Offset="0.52" />
                            <GradientStop Color="#9C111114" Offset="1" />
                          </LinearGradientBrush>
                        </Border.Background>
                      </Border>

                      <Grid Margin="28" ColumnDefinitions="138,*">
                        <Border
                            Width="138"
                            Height="208"
                            VerticalAlignment="Center"
                            Background="#2FFFFFFF"
                            CornerRadius="16"
                            BoxShadow="0 16 36 0 #66000000"
                            ClipToBounds="True">
                          <Grid>
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Classes="symbol"
                                Foreground="#BFFFFFFF"
                                FontSize="30"
                                Text="movie" />
                            <Image Source="{Binding ImageSource.Value^}" Stretch="UniformToFill" />
                          </Grid>
                        </Border>

                        <Grid
                            Grid.Column="1"
                            Margin="24,10,0,10"
                            RowDefinitions="Auto,*,Auto">
                          <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="8">
                              <TextBlock
                                  MaxHeight="82"
                                  Foreground="White"
                                  FontSize="34"
                                  FontWeight="SemiBold"
                                  LineHeight="40"
                                  SizeChanged="ContinueTitle_OnSizeChanged"
                                  Text="{Binding Title}"
                                  TextTrimming="CharacterEllipsis"
                                  TextWrapping="Wrap" />
                              <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border
                                    Padding="8,4"
                                    Background="#24FFFFFF"
                                    CornerRadius="999">
                                  <TextBlock
                                      Foreground="White"
                                      FontSize="11"
                                      FontWeight="SemiBold"
                                      Text="{Binding Category}" />
                                </Border>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="#BFFFFFFF"
                                    FontSize="12"
                                    IsVisible="{Binding HasDetails}"
                                    Text="{Binding Details}" />
                              </StackPanel>
                            </StackPanel>
                            <TextBlock
                                Grid.Column="1"
                                Margin="16,3,0,0"
                                VerticalAlignment="Top"
                                Foreground="#BFFFFFFF"
                                FontSize="11"
                                Text="{Binding LastViewedLabel}" />
                          </Grid>

                          <Grid
                              Grid.Row="2"
                              HorizontalAlignment="Left"
                              ColumnDefinitions="Auto,Auto">
                            <Button
                                Classes="continue-hero-action"
                                Command="{Binding OpenCommand}"
                                AutomationProperties.Name="Продолжить просмотр"
                                ToolTip.Tip="Продолжить просмотр">
                              <TextBlock
                                  Classes="symbol filled"
                                  FontSize="27"
                                  Text="play_arrow" />
                            </Button>
                            <StackPanel
                                Grid.Column="1"
                                MaxWidth="380"
                                Margin="14,0,0,0"
                                VerticalAlignment="Center"
                                Spacing="2">
                              <TextBlock
                                  Foreground="#AFFFFFFF"
                                  FontSize="10"
                                  FontWeight="SemiBold"
                                  Text="Продолжить просмотр" />
                              <TextBlock
                                  MaxWidth="290"
                                  Foreground="White"
                                  FontSize="12"
                                  FontWeight="SemiBold"
                                  Text="{Binding PlaybackPosition}"
                                  TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                          </Grid>
                        </Grid>
                      </Grid>
                    </Grid>
                  </DataTemplate>
                </ContentControl.ContentTemplate>
              </ContentControl>
            </Border>

            <Border
                MinHeight="220"
                Padding="32"
                Background="{DynamicResource Brush.Surface.Hero}"
                Classes="home-hero"
                CornerRadius="24"
                IsVisible="{Binding !HasContinueWatchingHero}">
              <Border.RenderTransform>
                <TransformGroup>
                  <ScaleTransform />
                  <TranslateTransform />
                </TransformGroup>
              </Border.RenderTransform>
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Spacing="10">
                  <TextBlock Classes="eyebrow" Text="ПРОДОЛЖИТЬ ПРОСМОТР" />
                  <TextBlock Classes="h1" Text="Здесь появится последний тайтл" />
                  <TextBlock
                      MaxWidth="620"
                      Classes="muted"
                      Text="Начните просмотр фильма или сериала — сохранённая позиция появится на главной."
                      TextWrapping="Wrap" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Classes="login-primary"
                    Command="{Binding QuickSearchCommand}"
                    CommandParameter="новинки">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <TextBlock Classes="symbol" FontSize="18" Text="search" />
                    <TextBlock Text="Найти тайтл" />
                  </StackPanel>
                </Button>
              </Grid>
            </Border>

            <StackPanel Classes="home-quick" Spacing="14">
              <StackPanel.RenderTransform><TranslateTransform /></StackPanel.RenderTransform>
              <TextBlock Classes="h2" Text="Быстрый выбор" />
              <ItemsControl ItemsSource="{Binding QuickSearches}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:QuickSearchItem">
                    <Button
                        Margin="0,0,10,8"
                        Classes="ghost"
                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).QuickSearchCommand}"
                        CommandParameter="{Binding Query}">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Classes="symbol" Text="search" />
                        <TextBlock Text="{Binding Title}" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel Classes="home-recent" Spacing="14">
              <StackPanel.RenderTransform><TranslateTransform /></StackPanel.RenderTransform>
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="h2" Text="Недавно открывали" />
                <Button
                    Grid.Column="1"
                    Padding="12,7"
                    Classes="ghost"
                    Command="{Binding ShowLibraryCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <TextBlock Text="В библиотеку" />
                    <TextBlock Classes="symbol" Text="arrow_forward" />
                  </StackPanel>
                </Button>
              </Grid>
              <ItemsRepeater
                  ClipToBounds="False"
                  HorizontalCacheLength="1"
                  ItemTemplate="{StaticResource MediaCardTemplate}"
                  ItemsSource="{Binding Recent}"
                  VerticalCacheLength="1">
                <ItemsRepeater.Layout>
                  <layout:UniformGridLayout
                      ItemsJustification="Start"
                      MinItemHeight="320"
                      MinItemWidth="190" />
                </ItemsRepeater.Layout>
              </ItemsRepeater>
              <Border
                  Padding="24"
                  Classes="card"
                  IsVisible="{Binding !Recent.Count}">
                <StackPanel HorizontalAlignment="Center" Spacing="8">
                  <TextBlock
                      HorizontalAlignment="Center"
                      Classes="symbol"
                      Foreground="{DynamicResource Brush.Text.Secondary}"
                      FontSize="30"
                      Text="history" />
                  <TextBlock Classes="muted" Text="Здесь появятся недавно открытые фильмы и сериалы" />
                </StackPanel>
              </Border>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <!-- Account library -->
        <ScrollViewer
            Classes="smooth-scroll"
            IsVisible="{Binding IsLibraryVisible}">
          <StackPanel
              MaxWidth="1120"
              Margin="28,126,28,56"
              HorizontalAlignment="Center"
              Spacing="28">
            <Grid ColumnDefinitions="*,Auto">
              <TextBox
                  VerticalContentAlignment="Center"
                  PlaceholderText="Поиск по HDRezka"
                  Text="{Binding SearchQuery}">
                <TextBox.KeyBindings>
                  <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
                </TextBox.KeyBindings>
              </TextBox>
              <Button
                  Grid.Column="1"
                  Margin="10,0,0,0"
                  Classes="primary"
                  Command="{Binding SearchCommand}">
                <TextBlock Classes="symbol" Text="search" />
              </Button>
            </Grid>

            <StackPanel Spacing="14">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <TextBlock Classes="h2" Text="Продолжить просмотр" />
                <TextBlock
                    VerticalAlignment="Center"
                    Classes="symbol filled"
                    Foreground="{StaticResource Brush.Brand}"
                    Text="resume" />
              </StackPanel>
              <ItemsRepeater
                  ClipToBounds="False"
                  HorizontalCacheLength="1"
                  ItemTemplate="{StaticResource MediaCardTemplate}"
                  ItemsSource="{Binding ContinueWatching}"
                  VerticalCacheLength="1">
                <ItemsRepeater.Layout>
                  <layout:UniformGridLayout
                      ItemsJustification="Start"
                      MinItemHeight="320"
                      MinItemWidth="190" />
                </ItemsRepeater.Layout>
              </ItemsRepeater>
            </StackPanel>

            <StackPanel IsVisible="{Binding Results.Count}" Spacing="14">
              <TextBlock Classes="h2" Text="Результаты поиска" />
              <ItemsRepeater
                  ClipToBounds="False"
                  HorizontalCacheLength="1"
                  ItemTemplate="{StaticResource MediaCardTemplate}"
                  ItemsSource="{Binding Results}"
                  VerticalCacheLength="1">
                <ItemsRepeater.Layout>
                  <layout:UniformGridLayout
                      ItemsJustification="Start"
                      MinItemHeight="320"
                      MinItemWidth="190" />
                </ItemsRepeater.Layout>
              </ItemsRepeater>
            </StackPanel>

            <StackPanel Spacing="14">
              <TextBlock Classes="h2" Text="Закладки" />
              <ItemsControl ItemsSource="{Binding BookmarkFolders}" />
            </StackPanel>

            <Border
                Padding="28"
                Classes="card"
                IsVisible="{Binding !IsBusy}">
              <StackPanel HorizontalAlignment="Center" Spacing="8">
                <TextBlock
                    HorizontalAlignment="Center"
                    Classes="symbol"
                    Foreground="{DynamicResource Brush.Text.Secondary}"
                    FontSize="32"
                    Text="bookmarks" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Classes="muted"
                    Text="{Binding StatusMessage}"
                    TextAlignment="Center" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- Settings -->
        <ScrollViewer
            Classes="smooth-scroll"
            IsVisible="{Binding IsSettingsVisible}">
          <StackPanel
              MaxWidth="920"
              Margin="28,126,28,56"
              HorizontalAlignment="Center"
              Spacing="24">
            <StackPanel Spacing="5">
              <TextBlock Classes="h1" Text="Настройки" />
              <TextBlock Classes="muted" Text="Внешний вид, подключение и текущая сессия" />
            </StackPanel>

            <Border Padding="24" Classes="card">
              <StackPanel Spacing="18">
                <StackPanel Spacing="5">
                  <TextBlock Classes="h2" Text="Оформление" />
                  <TextBlock Classes="muted" Text="Выберите тему интерфейса Rezui" />
                </StackPanel>
                <WrapPanel>
                  <Button
                      Margin="0,0,10,8"
                      Classes="theme-choice"
                      Classes.active="{Binding IsSystemTheme}"
                      Command="{Binding SetThemeCommand}"
                      CommandParameter="System">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Classes="symbol" Text="desktop_windows" />
                      <TextBlock Text="Системная" />
                    </StackPanel>
                  </Button>
                  <Button
                      Margin="0,0,10,8"
                      Classes="theme-choice"
                      Classes.active="{Binding IsLightTheme}"
                      Command="{Binding SetThemeCommand}"
                      CommandParameter="Light">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Classes="symbol filled" Text="light_mode" />
                      <TextBlock Text="Светлая" />
                    </StackPanel>
                  </Button>
                  <Button
                      Margin="0,0,10,8"
                      Classes="theme-choice"
                      Classes.active="{Binding IsDarkTheme}"
                      Command="{Binding SetThemeCommand}"
                      CommandParameter="Dark">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Classes="symbol filled" Text="dark_mode" />
                      <TextBlock Text="Тёмная" />
                    </StackPanel>
                  </Button>
                </WrapPanel>
              </StackPanel>
            </Border>

            <Border Padding="24" Classes="card">
              <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="5">
                  <TextBlock Classes="h2" Text="Диагностика" />
                  <TextBlock
                      Classes="muted"
                      Text="Журнал запуска, сети, кэша, синхронизации и ошибок" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Classes="ghost"
                    Command="{Binding OpenLogsFolderCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="symbol" Text="folder_open" />
                    <TextBlock Text="Открыть логи" />
                  </StackPanel>
                </Button>
              </Grid>
            </Border>

            <Border Padding="24" Classes="card">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Border
                    Width="58"
                    Height="58"
                    Background="{StaticResource Brush.Brand.Soft}"
                    CornerRadius="29"
                    ClipToBounds="True">
                  <Grid>
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource Brush.Brand}"
                        FontSize="17"
                        FontWeight="Bold"
                        Text="{Binding ProfileInitials}" />
                    <Image Source="{Binding ProfileImageSource^}" Stretch="UniformToFill" />
                  </Grid>
                </Border>
                <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                  <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding ProfileName}" />
                  <TextBlock Classes="muted" Text="{Binding ProfileEmail}" />
                </StackPanel>
                <Button
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Classes="ghost"
                    Command="{Binding LogoutCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="symbol" Text="logout" />
                    <TextBlock Text="Выйти" />
                  </StackPanel>
                </Button>
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- Media details -->
        <ScrollViewer
            x:Name="DetailsScrollViewer"
            Classes="smooth-scroll details-page"
            Classes.detailed-hero="{Binding UseDetailedHeroEntrance}"
            Classes.entering="{Binding IsDetailsEntering}"
            Classes.leaving="{Binding IsDetailsLeaving}"
            Classes.loading="{Binding IsDetailsContentLoading}"
            HorizontalScrollBarVisibility="Disabled"
            IsHitTestVisible="{Binding !IsDetailsContentLoading}"
            IsVisible="{Binding IsDetailsVisible}">
          <StackPanel Spacing="0">
            <Grid Height="620" ClipToBounds="False">
              <Border
                  Classes="details-hero-shadow"
                  Classes.visible="{Binding IsDetailsHeroSurfaceVisible}"
                  BoxShadow="0 22 54 0 #5C000000"
                  IsHitTestVisible="False">
                <Border.CacheMode>
                  <BitmapCache RenderAtScale="0.75" />
                </Border.CacheMode>
              </Border>
              <Border Classes="details-hero">
              <Border ClipToBounds="True">
                <Grid>
                <Border
                    Classes="details-hero-base"
                    Classes.visible="{Binding IsDetailsHeroSurfaceVisible}"
                    Background="#FF111114" />
                <Grid
                    Classes="details-hero-backdrop"
                    Classes.ready="{Binding IsDetailsHeroBackgroundReady}">
                  <Image
                      Classes="details-hero-background"
                      IsVisible="{Binding IsDetailsHeroPrimaryImageVisible}"
                      Margin="-56"
                      RenderTransformOrigin="50%,50%"
                      Source="{Binding DetailsImageSource}"
                      Stretch="UniformToFill">
                    <Image.Effect>
                      <BlurEffect Radius="44" />
                    </Image.Effect>
                    <Image.RenderTransform>
                      <ScaleTransform />
                    </Image.RenderTransform>
                  </Image>
                  <Image
                      Classes="details-hero-background details-hero-image-upgrade"
                      Classes.ready="{Binding IsDetailsHeroImageUpgradeReady}"
                      Margin="-56"
                      RenderTransformOrigin="50%,50%"
                      Source="{Binding DetailsHeroUpgradeImageSource}"
                      Stretch="UniformToFill">
                    <Image.Effect>
                      <BlurEffect Radius="44" />
                    </Image.Effect>
                    <Image.RenderTransform>
                      <ScaleTransform />
                    </Image.RenderTransform>
                  </Image>
                  <Border
                      Classes="details-hero-scrim"
                      Background="#A8111114"
                      Opacity="1" />
                </Grid>

                <StackPanel
                    Width="720"
                    Margin="28,94,28,28"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Classes="details-hero-content"
                    Classes.visible="{Binding IsDetailsHeroContentVisible}"
                    Classes.move-ready="{Binding IsDetailsHeroMetadataReady}"
                    Spacing="7">
                  <StackPanel
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Classes="details-hero-heading"
                      Spacing="10">
                  <Border
                      Width="148"
                      Height="212"
                      HorizontalAlignment="Center"
                      Background="#40111114"
                      BoxShadow="0 12 34 0 #66000000"
                      Classes="details-hero-poster"
                      CornerRadius="15"
                      ClipToBounds="True"
                      Opacity="1">
                    <Border.RenderTransform>
                      <TransformGroup>
                        <ScaleTransform />
                        <TranslateTransform />
                      </TransformGroup>
                    </Border.RenderTransform>
                    <Grid>
                      <Image
                          IsVisible="{Binding IsDetailsHeroPrimaryImageVisible}"
                          Source="{Binding DetailsImageSource}"
                          Stretch="UniformToFill" />
                      <Image
                          Classes="details-hero-poster-upgrade"
                          Classes.ready="{Binding IsDetailsHeroImageUpgradeReady}"
                          Source="{Binding DetailsHeroUpgradeImageSource}"
                          Stretch="UniformToFill" />
                    </Grid>
                  </Border>
                  <TextBlock
                      Width="720"
                      HorizontalAlignment="Center"
                      Classes="details-hero-title"
                      Foreground="White"
                      FontSize="{Binding DetailsTitleFontSize}"
                      FontWeight="SemiBold"
                      LineHeight="{Binding DetailsTitleLineHeight}"
                      MaxLines="3"
                      Opacity="1"
                      Text="{Binding DetailsTitle}"
                      TextAlignment="Center"
                      TextTrimming="CharacterEllipsis"
                      TextWrapping="Wrap">
                    <TextBlock.RenderTransform><TranslateTransform /></TextBlock.RenderTransform>
                  </TextBlock>
                  </StackPanel>
                  <StackPanel
                      Width="720"
                      HorizontalAlignment="Center"
                      Classes="details-hero-metadata"
                      Classes.visible="{Binding IsDetailsHeroMetadataVisible}"
                      IsHitTestVisible="{Binding IsDetailsHeroMetadataVisible}"
                      Spacing="7">
                  <Grid Width="720" Height="36" HorizontalAlignment="Center">
                    <TextBlock
                        Width="720"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Classes="details-hero-original"
                        Foreground="#AFFFFFFF"
                        FontSize="13"
                        LineHeight="18"
                        MaxLines="2"
                        Opacity="1"
                        Text="{Binding DetailsOriginalTitle}"
                        TextAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap">
                      <TextBlock.RenderTransform><TranslateTransform /></TextBlock.RenderTransform>
                    </TextBlock>
                  </Grid>
                  <WrapPanel
                      Height="18"
                      HorizontalAlignment="Center"
                      Classes="details-hero-meta"
                      Opacity="1">
                    <WrapPanel.RenderTransform><TranslateTransform /></WrapPanel.RenderTransform>
                    <TextBlock
                        Margin="7,0"
                        Foreground="White"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Text="{Binding DetailsRating}" />
                    <TextBlock
                        Margin="7,0"
                        Foreground="#CFFFFFFF"
                        FontSize="12"
                        Text="{Binding DetailsMeta}" />
                  </WrapPanel>
                  <Border
                      Width="188"
                      Height="46"
                      Margin="0,18,0,0"
                      HorizontalAlignment="Center"
                      Classes="details-hero-action"
                      Opacity="1">
                    <Border.RenderTransform>
                      <TransformGroup>
                        <ScaleTransform />
                        <TranslateTransform />
                      </TransformGroup>
                    </Border.RenderTransform>
                    <Button
                        Width="188"
                        Height="46"
                        Classes="details-watch"
                        Classes.available="{Binding CanWatchDetails}"
                        Command="{Binding OpenPlayerCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock
                            VerticalAlignment="Center"
                            Classes="symbol filled"
                            FontSize="21"
                            Text="play_arrow" />
                        <TextBlock
                            VerticalAlignment="Center"
                            LineHeight="21"
                            Text="Смотреть" />
                      </StackPanel>
                    </Button>
                  </Border>
                  </StackPanel>
                </StackPanel>
                </Grid>
              </Border>
            </Border>
            </Grid>

            <Grid
                MaxWidth="1120"
                Margin="28,28,28,64"
                HorizontalAlignment="Stretch"
                Classes="details-skeleton"
                ColumnDefinitions="1.5*,*"
                ColumnSpacing="22"
                RowDefinitions="Auto,Auto"
                IsVisible="{Binding IsDetailsContentLoading}">
              <Border Height="220" Padding="24" Classes="details-skeleton-card">
                <StackPanel Spacing="15">
                  <Border Width="176" Height="24" HorizontalAlignment="Left" Classes="details-skeleton-block" />
                  <Border Height="14" Classes="details-skeleton-block second" />
                  <Border Height="14" Classes="details-skeleton-block third" />
                  <Grid ColumnDefinitions="4*,*">
                    <Border Height="14" Classes="details-skeleton-block" />
                  </Grid>
                </StackPanel>
              </Border>
              <Border Grid.Column="1" Height="220" Padding="24" Classes="details-skeleton-card">
                <StackPanel Spacing="15">
                  <Border Width="142" Height="24" HorizontalAlignment="Left" Classes="details-skeleton-block second" />
                  <Grid ColumnDefinitions="112,*" ColumnSpacing="18">
                    <Border Height="12" Classes="details-skeleton-block third" />
                    <Border Grid.Column="1" Height="12" Classes="details-skeleton-block" />
                  </Grid>
                  <Grid ColumnDefinitions="112,*" ColumnSpacing="18">
                    <Border Height="12" Classes="details-skeleton-block second" />
                    <Border Grid.Column="1" Height="12" Classes="details-skeleton-block third" />
                  </Grid>
                  <Grid ColumnDefinitions="112,*" ColumnSpacing="18">
                    <Border Height="12" Classes="details-skeleton-block" />
                    <Border Grid.Column="1" Height="12" Classes="details-skeleton-block second" />
                  </Grid>
                </StackPanel>
              </Border>
              <TextBlock
                  Grid.Row="1"
                  Grid.ColumnSpan="2"
                  Margin="0,16,0,0"
                  HorizontalAlignment="Center"
                  Classes="muted"
                  FontSize="12"
                  Text="{Binding DetailsLoadingStatus}" />
            </Grid>

            <Border
                MaxWidth="1120"
                Margin="28,28,28,64"
                Padding="32"
                HorizontalAlignment="Stretch"
                Classes="card details-card details-load-error"
                IsVisible="{Binding IsDetailsContentLoadFailed}">
              <StackPanel HorizontalAlignment="Center" Spacing="10">
                <TextBlock
                    HorizontalAlignment="Center"
                    Classes="symbol"
                    Foreground="{DynamicResource Brush.Text.Secondary}"
                    FontSize="30"
                    Text="cloud_off" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Classes="h2"
                    Text="Не удалось загрузить данные тайтла" />
                <TextBlock
                    MaxWidth="620"
                    HorizontalAlignment="Center"
                    Classes="muted"
                    Text="{Binding DetailsContentError}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <Button
                    Margin="0,8,0,0"
                    HorizontalAlignment="Center"
                    Classes="login-primary details-retry"
                    Command="{Binding RetryDetailsContentCommand}">
                  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" Spacing="7">
                    <TextBlock Classes="symbol" FontSize="18" Text="refresh" />
                    <TextBlock Text="Попробовать снова" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Border>

            <StackPanel
                MaxWidth="1120"
                Margin="28,28,28,64"
                HorizontalAlignment="Stretch"
                Classes="details-body"
                IsVisible="{Binding IsDetailsContentReady}"
                Opacity="1"
                Spacing="32">
              <StackPanel.RenderTransform><TranslateTransform /></StackPanel.RenderTransform>
              <Grid ColumnDefinitions="1.5*,*" ColumnSpacing="22">
                <Border Padding="24" Classes="card details-card">
                  <StackPanel Spacing="12">
                    <TextBlock Classes="h2" Text="Описание" />
                    <TextBlock
                        FontSize="15"
                        LineHeight="23"
                        Text="{Binding DetailsDescription}"
                        TextWrapping="Wrap" />
                  </StackPanel>
                </Border>

                <Border Grid.Column="1" Padding="24" Classes="card details-card">
                  <StackPanel Spacing="12">
                    <TextBlock Classes="h2" Text="Подробности" />
                    <ItemsControl ItemsSource="{Binding DetailsFacts}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:DetailFactItem">
                          <Grid Margin="0,0,0,10" ColumnDefinitions="120,*">
                            <TextBlock Classes="muted" FontSize="12" Text="{Binding Label}" />
                            <TextBlock
                                Grid.Column="1"
                                FontSize="12"
                                IsVisible="{Binding HasPlainValue}"
                                Text="{Binding Value}"
                                TextWrapping="Wrap" />
                            <ItemsControl
                                Grid.Column="1"
                                IsVisible="{Binding HasCountries}"
                                ItemsSource="{Binding Countries}">
                              <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                              </ItemsControl.ItemsPanel>
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:CountryFlagItem">
                                  <StackPanel
                                      Margin="0,0,7,4"
                                      VerticalAlignment="Center"
                                      Orientation="Horizontal"
                                      Spacing="5">
                                    <Border
                                        Width="18"
                                        Height="12"
                                        VerticalAlignment="Center"
                                        CornerRadius="2"
                                        ClipToBounds="True"
                                        IsVisible="{Binding HasImage}">
                                      <Image Source="{Binding ImageSource}" Stretch="UniformToFill" />
                                    </Border>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Text="{Binding Name}" />
                                    <TextBlock
                                        Margin="-3,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        IsVisible="{Binding HasTrailingSeparator}"
                                        Text="," />
                                  </StackPanel>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Path
                                Grid.Column="1"
                                Width="22"
                                Height="22"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="{Binding Value}"
                                Data="{Binding AgeIcon}"
                                Fill="{DynamicResource Brush.Text.Primary}"
                                IsVisible="{Binding HasAgeIcon}"
                                Stretch="Uniform"
                                ToolTip.Tip="{Binding Value}" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </Grid>

              <StackPanel IsVisible="{Binding DetailsExternalRatings.Count}" Spacing="12">
                <TextBlock Classes="h2" Text="Рейтинги" />
                <ItemsControl
                    Margin="-18,-18,-18,-28"
                    ItemsSource="{Binding DetailsExternalRatings}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel Margin="18,18,18,28" /></ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="models:ExternalRatingItem">
                      <Border
                          Width="220"
                          Height="104"
                          Margin="0,0,12,10"
                          Padding="14"
                          Classes="rating-card"
                          Classes.imdb="{Binding IsImdb}"
                          Classes.kinopoisk="{Binding IsKinopoisk}"
                          Classes.worldart="{Binding IsWorldArt}"
                          Classes.other="{Binding IsOther}">
                        <Grid ColumnDefinitions="64,*">
                          <Border
                              Width="64"
                              Height="64"
                              CornerRadius="13"
                              ClipToBounds="True">
                            <Grid>
                              <Image
                                  IsVisible="{Binding IsImdb}"
                                  Source="avares://Rezui/Assets/imdb.png"
                                  Stretch="UniformToFill" />
                              <Image
                                  IsVisible="{Binding IsKinopoisk}"
                                  Source="avares://Rezui/Assets/kinopoisk.png"
                                  Stretch="UniformToFill" />
                              <Image
                                  IsVisible="{Binding IsWorldArt}"
                                  Source="avares://Rezui/Assets/worldart.png"
                                  Stretch="UniformToFill" />
                              <TextBlock
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  FontSize="12"
                                  FontWeight="SemiBold"
                                  IsVisible="{Binding IsOther}"
                                  Text="{Binding Source}"
                                  TextAlignment="Center"
                                  TextWrapping="Wrap" />
                            </Grid>
                          </Border>
                          <StackPanel Grid.Column="1" Margin="13,0,6,0" VerticalAlignment="Center" Spacing="1">
                            <TextBlock Classes="rating-source" FontSize="11" Text="{Binding Source}" />
                            <TextBlock Classes="rating-value" FontSize="27" FontWeight="SemiBold" Text="{Binding Value}" />
                            <TextBlock Classes="rating-votes" FontSize="10" Text="{Binding Votes}" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <StackPanel IsVisible="{Binding DetailsDirectors.Count}" Spacing="12">
                <TextBlock Classes="h2" Text="Режиссёры" />
                <ItemsRepeater
                    ClipToBounds="False"
                    HorizontalCacheLength="1"
                    ItemsSource="{Binding DetailsDirectors}"
                    VerticalCacheLength="1">
                  <ItemsRepeater.Layout>
                    <layout:UniformGridLayout
                        ItemsJustification="Start"
                        MinItemHeight="64"
                        MinItemWidth="182" />
                  </ItemsRepeater.Layout>
                  <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="models:PersonCardItem">
                      <Border Width="170" Margin="0,0,12,10" Padding="10" Classes="card details-card">
                        <Grid ColumnDefinitions="44,*">
                          <Border Width="44" Height="44" CornerRadius="22" ClipToBounds="True" Background="{DynamicResource Brush.Surface.Secondary}">
                            <Grid>
                              <TextBlock
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Classes="symbol filled"
                                  FontSize="25"
                                  Foreground="{DynamicResource Brush.Text.Secondary}"
                                  Text="person" />
                              <Image Source="{Binding ImageSource.Value^}" Stretch="UniformToFill" />
                            </Grid>
                          </Border>
                          <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                            <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Classes="muted" FontSize="10" Text="{Binding Job}" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
              </StackPanel>

              <StackPanel IsVisible="{Binding DetailsCast.Count}" Spacing="12">
                <TextBlock Classes="h2" Text="В ролях" />
                <ItemsRepeater
                    ClipToBounds="False"
                    HorizontalCacheLength="1"
                    ItemsSource="{Binding DetailsCast}"
                    VerticalCacheLength="1">
                  <ItemsRepeater.Layout>
                    <layout:UniformGridLayout
                        ItemsJustification="Start"
                        MinItemHeight="64"
                        MinItemWidth="182" />
                  </ItemsRepeater.Layout>
                  <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="models:PersonCardItem">
                      <Border Width="170" Margin="0,0,12,10" Padding="10" Classes="card details-card">
                        <Grid ColumnDefinitions="44,*">
                          <Border Width="44" Height="44" CornerRadius="22" ClipToBounds="True" Background="{DynamicResource Brush.Surface.Secondary}">
                            <Grid>
                              <TextBlock
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Classes="symbol filled"
                                  FontSize="25"
                                  Foreground="{DynamicResource Brush.Text.Secondary}"
                                  Text="person" />
                              <Image Source="{Binding ImageSource.Value^}" Stretch="UniformToFill" />
                            </Grid>
                          </Border>
                          <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                            <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Classes="muted" FontSize="10" Text="{Binding Job}" TextTrimming="CharacterEllipsis" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
              </StackPanel>

              <StackPanel IsVisible="{Binding DetailsSchedule.Count}" Spacing="12">
                <TextBlock Classes="h2" Text="Расписание серий" />
                <ItemsRepeater
                    ClipToBounds="False"
                    HorizontalCacheLength="1"
                    ItemsSource="{Binding DetailsSchedule}"
                    VerticalCacheLength="1">
                  <ItemsRepeater.Layout>
                    <layout:UniformGridLayout
                        ItemsJustification="Start"
                        MinItemHeight="86"
                        MinItemWidth="262" />
                  </ItemsRepeater.Layout>
                  <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="models:ScheduleCardItem">
                      <Border Width="250" Margin="0,0,12,10" Padding="14" Classes="card details-card">
                        <StackPanel Spacing="4">
                          <TextBlock FontSize="11" FontWeight="SemiBold" Text="{Binding EpisodeLabel}" />
                          <TextBlock FontSize="12" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Classes="muted" FontSize="10" Text="{Binding DateLabel}" />
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
              </StackPanel>

              <ItemsControl
                  IsVisible="{Binding HasDetailGroups}"
                  ItemsSource="{Binding DetailsGroups}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <UniformGrid
                        Columns="{Binding DetailsGroupColumnCount}"
                        ColumnSpacing="16" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:DetailGroupCardItem">
                    <Border Padding="20" Classes="card details-card">
                      <StackPanel Spacing="12">
                        <TextBlock Classes="h2" Text="{Binding Title}" />
                        <ItemsControl ItemsSource="{Binding Columns}">
                          <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                              <UniformGrid
                                  Columns="{Binding ColumnCount}"
                                  ColumnSpacing="20" />
                            </ItemsPanelTemplate>
                          </ItemsControl.ItemsPanel>
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:DetailGroupColumnItem">
                              <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate>
                                    <TextBlock
                                        Margin="0,0,0,7"
                                        FontSize="12"
                                        Text="{Binding}"
                                        TextWrapping="Wrap" />
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <StackPanel IsVisible="{Binding DetailsRecommendations.Count}" Spacing="14">
                <TextBlock Classes="h2" Text="Вам также понравится" />
                <ItemsRepeater
                    ClipToBounds="False"
                    HorizontalCacheLength="1"
                    ItemsSource="{Binding DetailsRecommendations}"
                    VerticalCacheLength="1">
                  <ItemsRepeater.Layout>
                    <layout:UniformGridLayout
                        ItemsJustification="Start"
                        MinItemHeight="320"
                        MinItemWidth="190" />
                  </ItemsRepeater.Layout>
                  <ItemsRepeater.ItemTemplate>
                    <DataTemplate x:DataType="models:MediaCardItem">
                      <Button
                          Width="174"
                          Margin="0,0,16,20"
                          Classes="media-card details-media-card"
                          Command="{Binding OpenCommand}">
                        <StackPanel Spacing="10">
                          <Border
                              Height="246"
                              Background="{DynamicResource Brush.Surface.Secondary}"
                              CornerRadius="16"
                              ClipToBounds="True">
                            <Grid>
                              <TextBlock
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Classes="symbol"
                                  Foreground="{DynamicResource Brush.Text.Secondary}"
                                  Text="movie" />
                              <Image Source="{Binding ImageSource.Value^}" Stretch="UniformToFill" />
                              <Border
                                  Padding="9,5"
                                  Margin="10"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Bottom"
                                  Background="#CC111014"
                                  CornerRadius="8">
                                <TextBlock
                                    Foreground="White"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Text="{Binding Category}" />
                              </Border>
                            </Grid>
                          </Border>
                          <TextBlock
                              MaxHeight="44"
                              FontSize="14"
                              FontWeight="SemiBold"
                              Text="{Binding Title}"
                              TextTrimming="CharacterEllipsis"
                              TextWrapping="Wrap" />
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
              </StackPanel>

              <StackPanel Spacing="14">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Classes="h2" Text="Комментарии" />
                  <TextBlock
                      Grid.Column="1"
                      VerticalAlignment="Center"
                      Classes="muted"
                      FontSize="15"
                      LineHeight="20"
                      Text="{Binding DetailsComments.Count, StringFormat='{}{0} загружено'}" />
                </Grid>
                <ItemsControl ItemTemplate="{StaticResource CommentNodeTemplate}" ItemsSource="{Binding DetailsComments}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Spacing="12" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
                <Border
                    Padding="24"
                    Classes="card details-card"
                    IsVisible="{Binding !DetailsComments.Count}">
                  <StackPanel HorizontalAlignment="Center" Spacing="7">
                    <TextBlock
                        HorizontalAlignment="Center"
                        Classes="symbol"
                        Foreground="{DynamicResource Brush.Text.Secondary}"
                        FontSize="24"
                        Text="forum" />
                    <TextBlock Classes="muted" Text="У этого тайтла пока нет комментариев" />
                  </StackPanel>
                </Border>
                <Button
                    HorizontalAlignment="Center"
                    Classes="details-load-more"
                    Command="{Binding LoadMoreCommentsCommand}"
                    IsEnabled="{Binding CanLoadMoreComments}"
                    IsVisible="{Binding CanLoadMoreComments}"
                    Content="Показать ещё" />
              </StackPanel>

            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <!-- Player -->
        <Grid
            IsVisible="{Binding IsPlayerVisible}"
            RowDefinitions="Auto,*,Auto">
          <Border Padding="24,14" Background="{DynamicResource Brush.Player.Chrome}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Button Classes="ghost" Command="{Binding BackFromPlayerCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Classes="symbol" Text="arrow_back" />
                  <TextBlock Text="Назад" />
                </StackPanel>
              </Button>
              <StackPanel Grid.Column="1" Margin="18,0" VerticalAlignment="Center">
                <TextBlock Foreground="White" FontWeight="SemiBold" Text="{Binding Player.Title}" />
                <TextBlock Foreground="#B8B8BC" FontSize="11" Text="{Binding Player.StatusText}" />
              </StackPanel>
              <Button Grid.Column="2" Classes="icon-button" Click="FullscreenButton_OnClick">
                <TextBlock Classes="symbol" Text="fullscreen" />
              </Button>
            </Grid>
          </Border>
          <Border Grid.Row="1" Background="Black">
            <ContentControl Content="{Binding Player.MediaPlayer}" />
          </Border>
          <Border Grid.Row="2" Padding="24,14" Background="{DynamicResource Brush.Player.Chrome}">
            <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
              <Grid ColumnDefinitions="2*,*,*,*,*,Auto" ColumnSpacing="10">
                <StackPanel Spacing="4">
                  <TextBlock Classes="player-field-label" Text="Озвучка" />
                  <ComboBox
                      Classes="player-select"
                      ItemsSource="{Binding Translations}"
                      SelectedItem="{Binding SelectedTranslation}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="models:TranslationItem">
                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="1" IsVisible="{Binding IsSeries}" Spacing="4">
                  <TextBlock Classes="player-field-label" Text="Сезон" />
                  <ComboBox
                      Classes="player-select"
                      ItemsSource="{Binding Seasons}"
                      SelectedItem="{Binding SelectedSeason}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="models:ChoiceItem">
                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="2" IsVisible="{Binding IsSeries}" Spacing="4">
                  <TextBlock Classes="player-field-label" Text="Серия" />
                  <ComboBox
                      Classes="player-select"
                      ItemsSource="{Binding Episodes}"
                      SelectedItem="{Binding SelectedEpisode}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="models:ChoiceItem">
                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="3" Spacing="4">
                  <TextBlock Classes="player-field-label" Text="Качество" />
                  <ComboBox
                      Classes="player-select"
                      ItemsSource="{Binding Qualities}"
                      SelectedItem="{Binding SelectedQuality}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="models:QualityItem">
                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
                <StackPanel Grid.Column="4" Spacing="4">
                  <TextBlock Classes="player-field-label" Text="Субтитры" />
                  <ComboBox
                      Classes="player-select"
                      ItemsSource="{Binding Subtitles}"
                      SelectedItem="{Binding SelectedSubtitle}">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="models:SubtitleItem">
                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                </StackPanel>
                <Button
                    Grid.Column="5"
                    Width="44"
                    Height="44"
                    Margin="0,18,0,0"
                    Padding="0"
                    Classes="player-apply"
                    Command="{Binding ApplyPlaybackSelectionCommand}">
                  <TextBlock Classes="symbol filled" FontSize="22" Text="play_arrow" />
                </Button>
              </Grid>
              <Slider
                  Grid.Row="1"
                  Maximum="{Binding Player.DurationMs}"
                  Minimum="0"
                  PointerReleased="SeekSlider_OnPointerReleased"
                  Value="{Binding Player.CurrentTimeMs, Mode=OneWay}" />
              <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,Auto,*,Auto,160">
                <Button
                    Padding="12,7"
                    Classes="ghost"
                    Command="{Binding Player.SkipBackCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Classes="symbol" Text="replay_10" />
                    <TextBlock Text="10" />
                  </StackPanel>
                </Button>
                <Button
                    Grid.Column="1"
                    Margin="8,0"
                    Padding="18,7"
                    Classes="primary"
                    Command="{Binding Player.TogglePlaybackCommand}">
                  <TextBlock Classes="symbol filled" Text="play_pause" />
                </Button>
                <Button
                    Grid.Column="2"
                    Padding="12,7"
                    Classes="ghost"
                    Command="{Binding Player.SkipForwardCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Classes="symbol" Text="forward_10" />
                    <TextBlock Text="10" />
                  </StackPanel>
                </Button>
                <TextBlock
                    Grid.Column="4"
                    Margin="16,0"
                    VerticalAlignment="Center"
                    Foreground="#B8B8BC">
                  <TextBlock.Inlines>
                    <Run Text="{Binding Player.CurrentTimeText}" />
                    <Run Text=" / " />
                    <Run Text="{Binding Player.DurationText}" />
                  </TextBlock.Inlines>
                </TextBlock>
                <Slider
                    Grid.Column="5"
                    Maximum="100"
                    Minimum="0"
                    Value="{Binding Player.Volume}" />
              </Grid>
            </Grid>
          </Border>
        </Grid>
      </Grid>

      <!-- Large in-app category popup, positioned independently of its trigger. -->
      <Grid
          ZIndex="15"
          ClipToBounds="False"
          IsHitTestVisible="{Binding IsCategoryMenuOpen}"
          IsVisible="{Binding !IsPlayerVisible}">
        <Button
            Classes="popup-dismiss"
            Command="{Binding CloseCategoryMenuCommand}"
            AutomationProperties.Name="Закрыть меню категорий" />
        <Grid ColumnDefinitions="24,*,24" ClipToBounds="False">
          <Border
              x:Name="CategoryMenuPopup"
              Grid.Column="1"
              ZIndex="1"
              MaxWidth="1000"
              Margin="0,90,0,24"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Top"
              Classes="category-mega-menu category-menu-popup"
              Classes.open="{Binding IsCategoryMenuOpen}"
              ClipToBounds="False"
              IsHitTestVisible="{Binding IsCategoryMenuOpen}">
            <ContentControl
                HorizontalContentAlignment="Stretch"
                Content="{Binding OpenCategoryMenu}" />
          </Border>
        </Grid>
      </Grid>

      <!-- In-app profile overlay keeps both opening and closing animations in the visual tree -->
      <Grid
          ZIndex="30"
          IsHitTestVisible="{Binding IsProfilePopupOpen}"
          IsVisible="{Binding !IsPlayerVisible}">
        <Button
            Classes="popup-dismiss"
            Command="{Binding CloseProfilePopupCommand}"
            AutomationProperties.Name="Закрыть меню профиля" />
        <Grid
            Width="{Binding Bounds.Width, ElementName=TopIsland}"
            HorizontalAlignment="Center">
          <Grid
              Width="38"
              Margin="0,0,7,0"
              HorizontalAlignment="Right">
            <Border
                x:Name="ProfilePopup"
                ZIndex="1"
                Width="220"
                Margin="0,92,0,0"
                Padding="8"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Classes="profile-popup"
                Classes.open="{Binding IsProfilePopupOpen}"
                IsHitTestVisible="{Binding IsProfilePopupOpen}">
            <StackPanel Spacing="7">
              <Border Padding="8" Classes="profile-header-card">
                <StackPanel
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                  <Border
                      Width="34"
                      Height="34"
                      Background="{DynamicResource Brush.TopBar.Accent.Soft}"
                      CornerRadius="17"
                      ClipToBounds="True">
                    <Grid>
                      <TextBlock
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Foreground="{DynamicResource Brush.TopBar.Accent}"
                          FontSize="11"
                          FontWeight="Bold"
                          Text="{Binding ProfileInitials}" />
                      <Image Source="{Binding ProfileImageSource^}" Stretch="UniformToFill" />
                    </Grid>
                  </Border>
                  <StackPanel
                      MaxWidth="150"
                      VerticalAlignment="Center"
                      Spacing="1">
                    <TextBlock
                        FontFamily="{StaticResource Font.Body}"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource Brush.Text.Primary}"
                        Text="{Binding ProfileName}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Classes="muted"
                        FontFamily="{StaticResource Font.Body}"
                        FontSize="10"
                        Text="{Binding ProfileEmail}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        IsVisible="{Binding IsPremium}"
                        Foreground="{DynamicResource Brush.TopBar.Accent}"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Text="Premium" />
                  </StackPanel>
                </StackPanel>
              </Border>

              <StackPanel Spacing="3">
                <Button
                    Classes="popup-nav"
                    Classes.active="{Binding IsLibraryVisible}"
                    Command="{Binding ShowLibraryCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock
                        Classes="symbol"
                        Classes.filled="{Binding IsLibraryVisible}"
                        FontSize="17"
                        Text="video_library" />
                    <TextBlock VerticalAlignment="Center" Text="Библиотека" />
                  </StackPanel>
                </Button>
                <Button
                    Classes="popup-nav"
                    Classes.active="{Binding IsSettingsVisible}"
                    Command="{Binding OpenSettingsCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock
                        Classes="symbol"
                        Classes.filled="{Binding IsSettingsVisible}"
                        FontSize="17"
                        Text="settings" />
                    <TextBlock VerticalAlignment="Center" Text="Настройки" />
                  </StackPanel>
                </Button>
                <Button
                    Classes="popup-nav logout"
                    Command="{Binding LogoutCommand}"
                    AutomationProperties.Name="Выйти из аккаунта">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="symbol" FontSize="17" Text="logout" />
                    <TextBlock VerticalAlignment="Center" Text="Выйти" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </StackPanel>
            </Border>
          </Grid>
        </Grid>
      </Grid>
    </Grid>

    <!-- Startup and mandatory authentication -->
    <Grid
        x:Name="StartupOverlay"
        Classes="startup-overlay"
        Classes.visible="{Binding IsStartupVisible}"
        IsVisible="{Binding IsStartupPresented}"
        Background="{DynamicResource Brush.App.Background}"
        RowDefinitions="*,Auto">
      <StackPanel
          x:Name="StartupWizardContent"
          Grid.Row="0"
          Width="560"
          Margin="0,0,0,30"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Classes="startup-wizard-content"
          Classes.visible="{Binding !IsStartupLoading}"
          IsVisible="{Binding !IsStartupLoading}"
          IsHitTestVisible="{Binding !IsStartupLoading}">
        <Carousel
            x:Name="StartupWizardCarousel"
            Height="460"
            IsSwipeEnabled="False"
            SelectedIndex="{Binding StartupWizardStep}">
          <Carousel.PageTransition>
            <transitions:SoftSlideFadeTransition />
          </Carousel.PageTransition>

          <Grid x:Name="LoginWizardPage">
            <StackPanel
                Width="440"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Classes="login-dismissable"
                Classes.dismissed="{Binding IsLoginSuccessTransition}"
                Spacing="26">
            <Grid
                x:Name="LoginBrandComposition"
                Width="260"
                Height="78"
                Margin="0,0,0,4"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsHitTestVisible="False">
              <StackPanel
                  Classes="login-connection-dots"
                  Classes.visible="{Binding AreLoginDotsVisible}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Orientation="Horizontal"
                  Spacing="7">
                <Border Classes="connection-dot first" />
                <Border Classes="connection-dot second" />
                <Border Classes="connection-dot third" />
              </StackPanel>
              <Image
                  Width="70"
                  Height="70"
                  HorizontalAlignment="Center"
                  Classes="login-rezka-logo"
                  Classes.shifted="{Binding IsLoginLogoShifted}"
                  RenderOptions.BitmapInterpolationMode="HighQuality"
                  Source="avares://Rezui/Assets/hdrezka.png"
                  Stretch="Uniform" />
            </Grid>

            <StackPanel HorizontalAlignment="Center" Spacing="5">
              <TextBlock
                  HorizontalAlignment="Center"
                  Classes="h1"
                  Text="{Binding StartupTitle}"
                  TextAlignment="Center" />
              <TextBlock
                  MaxWidth="390"
                  HorizontalAlignment="Center"
                  Classes="muted"
                  Text="{Binding StartupMessage}"
                  TextAlignment="Center"
                  TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel IsVisible="{Binding IsStartupAuthenticationRequired}" Spacing="15">
              <TextBox
                  x:Name="LoginEmailInput"
                  Classes="login-input"
                  PlaceholderText="Электронная почта"
                  Text="{Binding Login}"
                  VerticalContentAlignment="Center">
                <TextBox.InnerLeftContent>
                  <TextBlock Classes="symbol login-field-icon" Text="mail" />
                </TextBox.InnerLeftContent>
              </TextBox>
              <TextBox
                  x:Name="LoginPasswordInput"
                  Classes="login-input"
                  PasswordChar="●"
                  PlaceholderText="Пароль"
                  Text="{Binding Password}"
                  VerticalContentAlignment="Center">
                <TextBox.InnerLeftContent>
                  <TextBlock Classes="symbol login-field-icon" Text="lock" />
                </TextBox.InnerLeftContent>
                <TextBox.KeyBindings>
                  <KeyBinding Gesture="Enter" Command="{Binding LoginCommand}" />
                </TextBox.KeyBindings>
              </TextBox>
              <Button
                  x:Name="LoginSubmitButton"
                  HorizontalAlignment="Stretch"
                  Classes="login-primary"
                  Classes.running="{Binding IsLoginRunning}"
                  Command="{Binding LoginCommand}"
                  IsEnabled="{Binding CanLogin}">
                <Grid
                    MinWidth="92"
                    Height="24"
                    Classes="login-button-content"
                    Classes.running="{Binding IsLoginRunning}">
                  <StackPanel
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Classes="login-button-idle"
                      Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource Brush.Text.OnContrast}"
                        Text="Войти" />
                  </StackPanel>
                  <StackPanel
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Classes="login-button-busy"
                      Orientation="Horizontal"
                      Spacing="8">
                    <TextBlock
                        VerticalAlignment="Center"
                        Classes="symbol login-spinner"
                        Foreground="{DynamicResource Brush.Text.OnContrast}"
                        Text="progress_activity">
                      <TextBlock.RenderTransform>
                        <RotateTransform />
                      </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource Brush.Text.OnContrast}"
                        Text="Вхожу" />
                  </StackPanel>
                </Grid>
              </Button>
              <TextBlock
                  MinHeight="32"
                  Classes="login-status"
                  Classes.visible="{Binding IsLoginStatusVisible}"
                  Foreground="{StaticResource Brush.Danger}"
                  FontSize="12"
                  Text="{Binding LoginStatusMessage}"
                  TextAlignment="Center"
                  TextWrapping="Wrap" />
            </StackPanel>
            </StackPanel>
          </Grid>

          <Grid x:Name="MirrorWizardPage">
            <StackPanel
                Width="440"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="22">
            <StackPanel HorizontalAlignment="Center" Spacing="5">
              <TextBlock
                  HorizontalAlignment="Center"
                  Classes="h1"
                  Text="Подключение"
                  TextAlignment="Center" />
              <TextBlock
                  MaxWidth="390"
                  HorizontalAlignment="Center"
                  Classes="muted"
                  Text="Выберите зеркало с подходящей задержкой ответа"
                  TextAlignment="Center"
                  TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="0">
              <Border Classes="mirror-list">
                <StackPanel Spacing="0">
                  <Button
                      Classes="mirror-option"
                      Classes.active="{Binding IsAutoMirrorSelection}"
                      Command="{Binding SelectAutoMirrorCommand}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                      <TextBlock
                          VerticalAlignment="Center"
                          FontWeight="Normal"
                          Text="Автовыбор" />
                      <TextBlock
                          Grid.Column="1"
                          VerticalAlignment="Center"
                          Classes="muted"
                          FontSize="12"
                          Text="минимальный пинг" />
                    </Grid>
                  </Button>

                  <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding MirrorStatuses}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:MirrorStatusItem">
                          <Button
                              Margin="0"
                              Classes="mirror-option"
                              Classes.active="{Binding IsSelected}"
                              Classes.unavailable="{Binding !IsAvailable}"
                              Command="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).SelectMirrorCommand}"
                              CommandParameter="{Binding}"
                              IsEnabled="{Binding IsAvailable}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                              <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontWeight="Normal"
                                    Text="{Binding DisplayName}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Classes="muted"
                                    FontSize="11"
                                    IsVisible="{Binding IsCustom}"
                                    Text="своё" />
                              </StackPanel>
                              <TextBlock
                                  Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Classes="mirror-latency"
                                  Classes.unavailable="{Binding !IsAvailable}"
                                  Text="{Binding StatusText}" />
                            </Grid>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </StackPanel>
              </Border>

              <StackPanel Margin="0,10,0,0" Spacing="8">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBox
                      Classes="login-input mirror-custom-input"
                      PlaceholderText="https://example.com"
                      Text="{Binding CustomMirror}"
                      VerticalContentAlignment="Center">
                    <TextBox.KeyBindings>
                      <KeyBinding Gesture="Enter" Command="{Binding UseCustomMirrorCommand}" />
                    </TextBox.KeyBindings>
                  </TextBox>
                  <Button
                      x:Name="MirrorUseButton"
                      Grid.Column="1"
                      Classes="mirror-use"
                      Classes.running="{Binding IsUsingCustomMirror}"
                      Command="{Binding UseCustomMirrorCommand}"
                      IsEnabled="{Binding !IsUsingCustomMirror}">
                    <Grid
                        MinWidth="104"
                        Height="24"
                        Classes="login-button-content"
                        Classes.running="{Binding IsUsingCustomMirror}">
                      <StackPanel
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Classes="login-button-idle"
                          Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource Brush.Text.OnContrast}"
                            Text="Использовать" />
                      </StackPanel>
                      <StackPanel
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Classes="login-button-busy"
                          Orientation="Horizontal"
                          Spacing="8">
                        <TextBlock
                            VerticalAlignment="Center"
                            Classes="symbol login-spinner"
                            Foreground="{DynamicResource Brush.Text.OnContrast}"
                            Text="progress_activity">
                          <TextBlock.RenderTransform>
                            <RotateTransform />
                          </TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource Brush.Text.OnContrast}"
                            Text="Проверяю" />
                      </StackPanel>
                    </Grid>
                  </Button>
                </Grid>
                <TextBlock
                    MinHeight="16"
                    Classes="mirror-status"
                    Classes.visible="{Binding IsMirrorStatusVisible}"
                    Foreground="{DynamicResource Brush.Text.Secondary}"
                    FontSize="11"
                    Text="{Binding MirrorStatusMessage}"
                    TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>
            </StackPanel>
          </Grid>
        </Carousel>
      </StackPanel>

      <Carousel
          Grid.Row="1"
          Width="320"
          Margin="0,0,0,24"
          HorizontalAlignment="Center"
          Classes="startup-wizard-content"
          Classes.visible="{Binding !IsStartupLoading}"
          IsVisible="{Binding !IsStartupLoading}"
          IsHitTestVisible="{Binding !IsStartupLoading}"
          IsSwipeEnabled="False"
          SelectedIndex="{Binding StartupWizardStep}">
        <Carousel.PageTransition>
          <CrossFade Duration="0:0:0.16">
            <CrossFade.FadeInEasing>
              <CubicEaseOut />
            </CrossFade.FadeInEasing>
            <CrossFade.FadeOutEasing>
              <CubicEaseOut />
            </CrossFade.FadeOutEasing>
          </CrossFade>
        </Carousel.PageTransition>

        <Grid>
          <Button
              x:Name="MirrorAnchorButton"
              HorizontalAlignment="Center"
              Classes="mirror-anchor login-footer-item"
              Classes.dismissed="{Binding IsLoginSuccessTransition}"
              Command="{Binding OpenMirrorWizardCommand}"
              IsEnabled="{Binding IsMirrorSelectorEnabled}">
            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
              <TextBlock
                  VerticalAlignment="Center"
                  Classes="symbol connection-spinner"
                  IsVisible="{Binding IsMirrorCheckRunning}"
                  Text="progress_activity" />
              <TextBlock
                  VerticalAlignment="Center"
                  Classes="symbol"
                  IsVisible="{Binding !IsMirrorCheckRunning}"
                  Text="language" />
              <TextBlock
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Text="{Binding MirrorSelectorLabel}" />
            </Grid>
          </Button>
        </Grid>

        <Grid>
          <Button
              HorizontalAlignment="Center"
              Classes="mirror-anchor login-footer-item"
              Classes.dismissed="{Binding IsLoginSuccessTransition}"
              Command="{Binding CloseMirrorWizardCommand}">
            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
              <TextBlock
                  VerticalAlignment="Center"
                  Classes="symbol"
                  Text="arrow_back" />
              <TextBlock
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Text="Вернуться ко входу" />
            </Grid>
          </Button>
        </Grid>
      </Carousel>

      <Image
          x:Name="LoginFoxLogo"
          Grid.RowSpan="2"
          Width="78"
          Height="78"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          IsHitTestVisible="False"
          Classes="login-fox-logo"
          Classes.centered="{Binding IsLoginFoxCentered}"
          Classes.motion-suppressed="{Binding IsLoginFoxMotionSuppressed}"
          Classes.visible="{Binding IsLoginFoxVisible}"
          RenderOptions.BitmapInterpolationMode="HighQuality"
          Source="avares://Rezui/Assets/rezui.png"
          Stretch="Uniform" />

      <Grid
          x:Name="StartupLoadingContent"
          Grid.RowSpan="2"
          Classes="startup-loading-content"
          IsVisible="{Binding IsStartupLoading}"
          IsHitTestVisible="{Binding IsStartupLoading}">
        <Image
            x:Name="StartupLoadingLogo"
            Width="78"
            Height="78"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Classes="startup-loading-logo"
            Classes.handoff="{Binding IsLoginSuccessTransition}"
            RenderOptions.BitmapInterpolationMode="HighQuality"
            Source="avares://Rezui/Assets/rezui.png"
            Stretch="Uniform" />
        <TextBlock
            x:Name="StartupSpinner"
            Margin="0,132,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Classes="symbol login-spinner startup-spinner"
            Classes.visible="{Binding IsStartupLoading}"
            FontSize="30"
            Foreground="{DynamicResource Brush.Text.Secondary}"
            Text="progress_activity">
          <TextBlock.RenderTransform>
            <RotateTransform />
          </TextBlock.RenderTransform>
        </TextBlock>
        <TextBlock
            Margin="24,198,24,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontFamily="{StaticResource Font.Body}"
            Foreground="{DynamicResource Brush.Text.Secondary}"
            FontSize="12"
            Text="{Binding StartupMessage}"
            TextAlignment="Center"
            TextWrapping="Wrap" />
      </Grid>
    </Grid>

    <!-- Non-blocking operation status -->
    <Border
        Margin="0,0,24,24"
        Padding="16,12"
        HorizontalAlignment="Right"
        VerticalAlignment="Bottom"
        Classes="island"
        IsVisible="{Binding IsBusy}">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <ProgressBar
            Width="90"
            VerticalAlignment="Center"
            IsIndeterminate="True" />
        <TextBlock
            MaxWidth="320"
            VerticalAlignment="Center"
            Text="{Binding StatusMessage}"
            TextTrimming="CharacterEllipsis" />
        <Button
            Padding="9,5"
            Command="{Binding CancelOperationCommand}"
            Content="Отмена" />
      </StackPanel>
    </Border>

  </Grid>
</Window>
