<Window
    x:Name="RootWindow"
    x:Class="Rezui.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:Rezui.Models"
    xmlns:transitions="clr-namespace:Rezui.Transitions"
    xmlns:vm="clr-namespace:Rezui.ViewModels"
    xmlns:vlc="clr-namespace:LibVLCSharp.Avalonia;assembly=LibVLCSharp.Avalonia"
    xmlns:vlcShared="clr-namespace:LibVLCSharp.Shared;assembly=LibVLCSharp"
    x:DataType="vm:MainWindowViewModel"
    mc:Ignorable="d"
    Width="1320"
    Height="840"
    MinWidth="1000"
    MinHeight="700"
    Title="Rezui">

  <Window.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding CloseProfilePopupCommand}" />
  </Window.KeyBindings>

  <Window.DataTemplates>
    <DataTemplate DataType="models:MediaCardItem">
      <Button
          Width="174"
          Margin="0,0,16,20"
          Classes="media-card"
          Command="{Binding OpenCommand}">
        <StackPanel Spacing="10">
          <Border
              Height="246"
              Background="{DynamicResource Brush.Surface.Secondary}"
              BorderBrush="{DynamicResource Brush.Border.Subtle}"
              BorderThickness="1"
              CornerRadius="16"
              ClipToBounds="True">
            <Grid>
              <TextBlock
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Classes="symbol"
                  Foreground="{DynamicResource Brush.Text.Secondary}"
                  Text="movie" />
              <Image Source="{Binding ImageSource^}" Stretch="UniformToFill" />
              <Border
                  Padding="9,5"
                  Margin="10"
                  HorizontalAlignment="Left"
                  VerticalAlignment="Bottom"
                  Background="#CC111014"
                  CornerRadius="8">
                <TextBlock
                    Foreground="White"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Text="{Binding Category}" />
              </Border>
            </Grid>
          </Border>
          <TextBlock
              MaxHeight="44"
              FontSize="14"
              FontWeight="SemiBold"
              Text="{Binding Title}"
              TextTrimming="CharacterEllipsis"
              TextWrapping="Wrap" />
        </StackPanel>
      </Button>
    </DataTemplate>

    <DataTemplate DataType="models:LibraryFolderItem">
      <StackPanel Margin="0,0,0,26" Spacing="14">
        <StackPanel Orientation="Horizontal" Spacing="9">
          <TextBlock Classes="h2" Text="{Binding Name}" />
          <Border
              Padding="8,3"
              VerticalAlignment="Center"
              Background="{DynamicResource Brush.Surface.Secondary}"
              CornerRadius="999">
            <TextBlock
                Classes="muted"
                FontSize="11"
                Text="{Binding ItemCount}" />
          </Border>
        </StackPanel>
        <ItemsControl ItemsSource="{Binding Items}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="vlcShared:MediaPlayer">
      <vlc:VideoView MediaPlayer="{Binding}" />
    </DataTemplate>

    <DataTemplate DataType="models:CategoryMenuDefinition">
      <Grid Margin="18" RowDefinitions="Auto,Auto" RowSpacing="14">
        <Border Padding="12" Classes="mega-menu-header">
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <StackPanel VerticalAlignment="Center" Spacing="2">
              <TextBlock
                  FontSize="17"
                  FontWeight="SemiBold"
                  Text="{Binding Title}" />
              <TextBlock
                  Classes="muted"
                  FontSize="11"
                  Text="Жанры и направления" />
            </StackPanel>
            <Button
                Grid.Column="1"
                Classes="mega-menu-action"
                Command="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).BrowseCategoryCommand}"
                CommandParameter="{Binding NewDescriptor}"
                Content="Новинки" />
            <Button
                Grid.Column="2"
                Classes="mega-menu-action contrast"
                Command="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).BrowseCategoryCommand}"
                CommandParameter="{Binding AllDescriptor}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Text="{Binding AllLabel}"
                    TextAlignment="Center" />
                <TextBlock
                    Classes="symbol mega-menu-action-arrow"
                    FontSize="16"
                    Text="arrow_forward" />
              </StackPanel>
            </Button>
          </Grid>
        </Border>

        <ItemsControl Grid.Row="1" ItemsSource="{Binding Columns}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="4" ColumnSpacing="8" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:CategoryMenuColumn">
              <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:CategoryMenuItem">
                    <Button
                        Classes="mega-menu-item"
                        Command="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).BrowseCategoryCommand}"
                        CommandParameter="{Binding Descriptor}"
                        Content="{Binding Title}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </DataTemplate>
  </Window.DataTemplates>

  <Grid>
    <!-- Main application shell -->
    <Grid
        IsVisible="{Binding IsShellVisible}">
      <Border
          ZIndex="10"
          Width="{Binding Bounds.Width, ElementName=TopIsland}"
          Height="{Binding Bounds.Height, ElementName=TopIsland}"
          Margin="28,22,28,0"
          HorizontalAlignment="Center"
          VerticalAlignment="Top"
          IsHitTestVisible="False"
          IsVisible="{Binding !IsPlayerVisible}"
          Classes="top-island-shadow" />
      <Border
          x:Name="TopIsland"
          ZIndex="20"
          MaxWidth="1120"
          Margin="28,22,28,0"
          Padding="7"
          HorizontalAlignment="Center"
          VerticalAlignment="Top"
          IsVisible="{Binding !IsPlayerVisible}"
          Classes="island top-island">
        <Grid ColumnDefinitions="Auto,12,Auto,Auto,Auto,Auto,Auto,12,Auto">
          <Image
              Width="34"
              Height="34"
              RenderOptions.BitmapInterpolationMode="HighQuality"
              Source="avares://Rezui/Assets/rezui.png"
              Stretch="Uniform" />

          <Button
              Grid.Column="2"
              Classes="nav"
              Classes.active="{Binding IsHomeVisible}"
              Command="{Binding ShowHomeCommand}">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock
                  Classes="symbol"
                  Classes.filled="{Binding IsHomeVisible}"
                  FontSize="16"
                  Text="home" />
              <TextBlock VerticalAlignment="Center" Text="Главная" />
            </StackPanel>
          </Button>
          <Button
              x:Name="FilmsNavButton"
              Grid.Column="3"
              Classes="nav category"
              Classes.active="{Binding IsFilmsCategory}"
              Classes.menu-open="{Binding IsFilmsMenuOpen}"
              Command="{Binding ToggleCategoryMenuCommand}"
              CommandParameter="{Binding FilmsMenu}">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock
                  Classes="symbol"
                  Classes.filled="{Binding IsFilmsCategory}"
                  FontSize="16"
                  Text="movie" />
              <TextBlock VerticalAlignment="Center" Text="Фильмы" />
              <TextBlock Classes="symbol chevron" FontSize="16" Text="expand_more" />
            </StackPanel>
          </Button>
          <Button
              x:Name="SeriesNavButton"
              Grid.Column="4"
              Classes="nav category"
              Classes.active="{Binding IsSeriesCategory}"
              Classes.menu-open="{Binding IsSeriesMenuOpen}"
              Command="{Binding ToggleCategoryMenuCommand}"
              CommandParameter="{Binding SeriesMenu}">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock
                  Classes="symbol"
                  Classes.filled="{Binding IsSeriesCategory}"
                  FontSize="16"
                  Text="tv" />
              <TextBlock VerticalAlignment="Center" Text="Сериалы" />
              <TextBlock Classes="symbol chevron" FontSize="16" Text="expand_more" />
            </StackPanel>
          </Button>
          <Button
              x:Name="CartoonsNavButton"
              Grid.Column="5"
              Classes="nav category"
              Classes.active="{Binding IsCartoonsCategory}"
              Classes.menu-open="{Binding IsCartoonsMenuOpen}"
              Command="{Binding ToggleCategoryMenuCommand}"
              CommandParameter="{Binding CartoonsMenu}">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock
                  Classes="symbol"
                  Classes.filled="{Binding IsCartoonsCategory}"
                  FontSize="16"
                  Text="palette" />
              <TextBlock VerticalAlignment="Center" Text="Мультфильмы" />
              <TextBlock Classes="symbol chevron" FontSize="16" Text="expand_more" />
            </StackPanel>
          </Button>
          <Button
              x:Name="AnimeNavButton"
              Grid.Column="6"
              Classes="nav category"
              Classes.active="{Binding IsAnimeCategory}"
              Classes.menu-open="{Binding IsAnimeMenuOpen}"
              Command="{Binding ToggleCategoryMenuCommand}"
              CommandParameter="{Binding AnimeMenu}">
            <StackPanel Orientation="Horizontal" Spacing="5">
              <TextBlock
                  Classes="symbol"
                  Classes.filled="{Binding IsAnimeCategory}"
                  FontSize="16"
                  Text="auto_awesome" />
              <TextBlock VerticalAlignment="Center" Text="Аниме" />
              <TextBlock Classes="symbol chevron" FontSize="16" Text="expand_more" />
            </StackPanel>
          </Button>

          <Button
              x:Name="ProfileAvatarButton"
              Grid.Column="8"
              Classes="profile-avatar"
              Command="{Binding ToggleProfilePopupCommand}"
              AutomationProperties.Name="Открыть меню профиля">
            <Border
                Width="34"
                Height="34"
                Background="{DynamicResource Brush.TopBar.Accent.Soft}"
                Classes="profile-avatar-image"
                CornerRadius="17"
                ClipToBounds="True">
              <Grid>
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource Brush.TopBar.Accent}"
                    FontSize="12"
                    FontWeight="Bold"
                    Text="{Binding ProfileInitials}" />
                <Image Source="{Binding ProfileImageSource^}" Stretch="UniformToFill" />
              </Grid>
            </Border>
          </Button>
        </Grid>
      </Border>

      <Grid
          ZIndex="0"
          Background="{DynamicResource Brush.App.Background}">
        <!-- Home -->
        <ScrollViewer
            IsVisible="{Binding IsHomeVisible}">
          <StackPanel
              MaxWidth="1120"
              Margin="28,126,28,56"
              HorizontalAlignment="Center"
              Spacing="32">
            <Border
                MinHeight="250"
                Padding="36"
                Background="{DynamicResource Brush.Surface.Hero}"
                BorderBrush="{DynamicResource Brush.Border.Subtle}"
                BorderThickness="1"
                CornerRadius="24">
              <Grid ColumnDefinitions="*,300">
                <StackPanel MaxWidth="680" VerticalAlignment="Center" Spacing="16">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock
                        Classes="symbol filled"
                        Foreground="{StaticResource Brush.Brand}"
                        Text="auto_awesome" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Classes="eyebrow"
                        Foreground="{StaticResource Brush.Brand}"
                        Text="ВАША КИНОБИБЛИОТЕКА" />
                  </StackPanel>
                  <TextBlock
                      Classes="display"
                      Text="Смотреть проще&#x0a;Возвращаться приятнее"
                      TextWrapping="Wrap" />
                  <TextBlock
                      MaxWidth="620"
                      Classes="muted"
                      FontSize="15"
                      LineHeight="22"
                      Text="Поиск, сохранённые позиции, закладки и профиль HDRezka — в одном спокойном десктопном пространстве"
                      TextWrapping="Wrap" />
                  <Grid MaxWidth="610" ColumnDefinitions="*,Auto">
                    <TextBox
                        VerticalContentAlignment="Center"
                        PlaceholderText="Фильм, сериал или аниме"
                        Text="{Binding SearchQuery}">
                      <TextBox.KeyBindings>
                        <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
                      </TextBox.KeyBindings>
                    </TextBox>
                    <Button
                        Grid.Column="1"
                        Margin="10,0,0,0"
                        Classes="primary"
                        Command="{Binding SearchCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Classes="symbol" Text="search" />
                        <TextBlock Text="Найти" />
                      </StackPanel>
                    </Button>
                  </Grid>
                </StackPanel>

                <Grid Grid.Column="1">
                  <Ellipse
                      Width="230"
                      Height="230"
                      Fill="{StaticResource Brush.Brand.Soft}" />
                  <Ellipse
                      Width="152"
                      Height="152"
                      Fill="{StaticResource Brush.Brand}" />
                  <TextBlock
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Classes="symbol filled"
                      Foreground="White"
                      FontSize="72"
                      Text="play_arrow" />
                </Grid>
              </Grid>
            </Border>

            <StackPanel Spacing="14">
              <TextBlock Classes="h2" Text="Быстрый выбор" />
              <ItemsControl ItemsSource="{Binding QuickSearches}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:QuickSearchItem">
                    <Button
                        Margin="0,0,10,8"
                        Classes="ghost"
                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).QuickSearchCommand}"
                        CommandParameter="{Binding Query}">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Classes="symbol" Text="search" />
                        <TextBlock Text="{Binding Title}" />
                      </StackPanel>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel Spacing="14">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="h2" Text="Недавно открывали" />
                <Button
                    Grid.Column="1"
                    Padding="12,7"
                    Classes="ghost"
                    Command="{Binding ShowLibraryCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <TextBlock Text="В библиотеку" />
                    <TextBlock Classes="symbol" Text="arrow_forward" />
                  </StackPanel>
                </Button>
              </Grid>
              <ItemsControl ItemsSource="{Binding Recent}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
              <Border
                  Padding="24"
                  Classes="card"
                  IsVisible="{Binding !Recent.Count}">
                <StackPanel HorizontalAlignment="Center" Spacing="8">
                  <TextBlock
                      HorizontalAlignment="Center"
                      Classes="symbol"
                      Foreground="{DynamicResource Brush.Text.Secondary}"
                      FontSize="30"
                      Text="history" />
                  <TextBlock Classes="muted" Text="Здесь появятся недавно открытые фильмы и сериалы" />
                </StackPanel>
              </Border>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <!-- Account library -->
        <ScrollViewer
            IsVisible="{Binding IsLibraryVisible}">
          <StackPanel
              MaxWidth="1120"
              Margin="28,126,28,56"
              HorizontalAlignment="Center"
              Spacing="28">
            <Grid ColumnDefinitions="*,Auto">
              <TextBox
                  VerticalContentAlignment="Center"
                  PlaceholderText="Поиск по HDRezka"
                  Text="{Binding SearchQuery}">
                <TextBox.KeyBindings>
                  <KeyBinding Gesture="Enter" Command="{Binding SearchCommand}" />
                </TextBox.KeyBindings>
              </TextBox>
              <Button
                  Grid.Column="1"
                  Margin="10,0,0,0"
                  Classes="primary"
                  Command="{Binding SearchCommand}">
                <TextBlock Classes="symbol" Text="search" />
              </Button>
            </Grid>

            <StackPanel Spacing="14">
              <StackPanel Orientation="Horizontal" Spacing="9">
                <TextBlock Classes="h2" Text="Продолжить просмотр" />
                <TextBlock
                    VerticalAlignment="Center"
                    Classes="symbol filled"
                    Foreground="{StaticResource Brush.Brand}"
                    Text="resume" />
              </StackPanel>
              <ItemsControl ItemsSource="{Binding ContinueWatching}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
            </StackPanel>

            <StackPanel IsVisible="{Binding Results.Count}" Spacing="14">
              <TextBlock Classes="h2" Text="Результаты поиска" />
              <ItemsControl ItemsSource="{Binding Results}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
            </StackPanel>

            <StackPanel Spacing="14">
              <TextBlock Classes="h2" Text="Закладки" />
              <ItemsControl ItemsSource="{Binding BookmarkFolders}" />
            </StackPanel>

            <Border
                Padding="28"
                Classes="card"
                IsVisible="{Binding !IsBusy}">
              <StackPanel HorizontalAlignment="Center" Spacing="8">
                <TextBlock
                    HorizontalAlignment="Center"
                    Classes="symbol"
                    Foreground="{DynamicResource Brush.Text.Secondary}"
                    FontSize="32"
                    Text="bookmarks" />
                <TextBlock
                    HorizontalAlignment="Center"
                    Classes="muted"
                    Text="{Binding StatusMessage}"
                    TextAlignment="Center" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- Settings -->
        <ScrollViewer
            IsVisible="{Binding IsSettingsVisible}">
          <StackPanel
              MaxWidth="920"
              Margin="28,126,28,56"
              HorizontalAlignment="Center"
              Spacing="24">
            <StackPanel Spacing="5">
              <TextBlock Classes="h1" Text="Настройки" />
              <TextBlock Classes="muted" Text="Внешний вид, подключение и текущая сессия" />
            </StackPanel>

            <Border Padding="24" Classes="card">
              <StackPanel Spacing="18">
                <StackPanel Spacing="5">
                  <TextBlock Classes="h2" Text="Оформление" />
                  <TextBlock Classes="muted" Text="Выберите тему интерфейса Rezui" />
                </StackPanel>
                <WrapPanel>
                  <Button
                      Margin="0,0,10,8"
                      Classes="theme-choice"
                      Classes.active="{Binding IsSystemTheme}"
                      Command="{Binding SetThemeCommand}"
                      CommandParameter="System">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Classes="symbol" Text="desktop_windows" />
                      <TextBlock Text="Системная" />
                    </StackPanel>
                  </Button>
                  <Button
                      Margin="0,0,10,8"
                      Classes="theme-choice"
                      Classes.active="{Binding IsLightTheme}"
                      Command="{Binding SetThemeCommand}"
                      CommandParameter="Light">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Classes="symbol filled" Text="light_mode" />
                      <TextBlock Text="Светлая" />
                    </StackPanel>
                  </Button>
                  <Button
                      Margin="0,0,10,8"
                      Classes="theme-choice"
                      Classes.active="{Binding IsDarkTheme}"
                      Command="{Binding SetThemeCommand}"
                      CommandParameter="Dark">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Classes="symbol filled" Text="dark_mode" />
                      <TextBlock Text="Тёмная" />
                    </StackPanel>
                  </Button>
                </WrapPanel>
              </StackPanel>
            </Border>

            <Border Padding="24" Classes="card">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <Border
                    Width="58"
                    Height="58"
                    Background="{StaticResource Brush.Brand.Soft}"
                    CornerRadius="29"
                    ClipToBounds="True">
                  <Grid>
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource Brush.Brand}"
                        FontSize="17"
                        FontWeight="Bold"
                        Text="{Binding ProfileInitials}" />
                    <Image Source="{Binding ProfileImageSource^}" Stretch="UniformToFill" />
                  </Grid>
                </Border>
                <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                  <TextBlock FontSize="17" FontWeight="SemiBold" Text="{Binding ProfileName}" />
                  <TextBlock Classes="muted" Text="{Binding ProfileEmail}" />
                </StackPanel>
                <Button
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Classes="ghost"
                    Command="{Binding LogoutCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="symbol" Text="logout" />
                    <TextBlock Text="Выйти" />
                  </StackPanel>
                </Button>
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <!-- Media details -->
        <ScrollViewer
            IsVisible="{Binding IsDetailsVisible}">
          <Grid
              MaxWidth="1120"
              Margin="28,126,28,56"
              HorizontalAlignment="Center"
              ColumnDefinitions="280,*">
            <StackPanel Spacing="14">
              <Border
                  Height="400"
                  Background="{DynamicResource Brush.Surface.Secondary}"
                  CornerRadius="18"
                  ClipToBounds="True">
                <Grid>
                  <TextBlock
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Classes="symbol"
                      Foreground="{DynamicResource Brush.Text.Secondary}"
                      FontSize="48"
                      Text="movie" />
                  <Image Source="{Binding DetailsImageSource^}" Stretch="UniformToFill" />
                </Grid>
              </Border>
              <Border Padding="16" Classes="card">
                <StackPanel Spacing="5">
                  <TextBlock FontWeight="SemiBold" Text="{Binding DetailsRating}" />
                  <TextBlock
                      Classes="muted"
                      FontSize="12"
                      Text="{Binding DetailsMeta}"
                      TextWrapping="Wrap" />
                </StackPanel>
              </Border>
            </StackPanel>

            <StackPanel Grid.Column="1" Margin="32,0,0,0" Spacing="20">
              <Button
                  HorizontalAlignment="Left"
                  Padding="12,7"
                  Classes="ghost"
                  Command="{Binding ShowLibraryCommand}">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <TextBlock Classes="symbol" Text="arrow_back" />
                  <TextBlock Text="Библиотека" />
                </StackPanel>
              </Button>
              <StackPanel Spacing="4">
                <TextBlock Classes="h1" Text="{Binding DetailsTitle}" TextWrapping="Wrap" />
                <TextBlock
                    Classes="muted"
                    FontSize="15"
                    Text="{Binding DetailsOriginalTitle}" />
              </StackPanel>
              <TextBlock
                  MaxWidth="780"
                  FontSize="15"
                  LineHeight="23"
                  Text="{Binding DetailsDescription}"
                  TextWrapping="Wrap" />

              <Border Padding="22" Classes="card">
                <StackPanel Spacing="16">
                  <TextBlock Classes="h2" Text="Параметры просмотра" />
                  <Grid ColumnDefinitions="*,*" ColumnSpacing="14">
                    <StackPanel Spacing="7">
                      <TextBlock Classes="eyebrow" Text="ОЗВУЧКА" />
                      <ComboBox
                          ItemsSource="{Binding Translations}"
                          SelectedItem="{Binding SelectedTranslation}">
                        <ComboBox.ItemTemplate>
                          <DataTemplate x:DataType="models:TranslationItem">
                            <TextBlock Text="{Binding DisplayName}" />
                          </DataTemplate>
                        </ComboBox.ItemTemplate>
                      </ComboBox>
                    </StackPanel>
                    <Grid
                        Grid.Column="1"
                        ColumnDefinitions="*,*"
                        ColumnSpacing="10"
                        IsVisible="{Binding IsSeries}">
                      <StackPanel Spacing="7">
                        <TextBlock Classes="eyebrow" Text="СЕЗОН" />
                        <ComboBox ItemsSource="{Binding Seasons}" SelectedItem="{Binding SelectedSeason}">
                          <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:ChoiceItem">
                              <TextBlock Text="{Binding Title}" />
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="7">
                        <TextBlock Classes="eyebrow" Text="СЕРИЯ" />
                        <ComboBox ItemsSource="{Binding Episodes}" SelectedItem="{Binding SelectedEpisode}">
                          <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="models:ChoiceItem">
                              <TextBlock Text="{Binding Title}" />
                            </DataTemplate>
                          </ComboBox.ItemTemplate>
                        </ComboBox>
                      </StackPanel>
                    </Grid>
                  </Grid>
                  <Button
                      HorizontalAlignment="Left"
                      Classes="primary"
                      Command="{Binding ResolvePlaybackCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Classes="symbol filled" Text="play_arrow" />
                      <TextBlock Text="Смотреть" />
                    </StackPanel>
                  </Button>
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>
        </ScrollViewer>

        <!-- Player -->
        <Grid
            IsVisible="{Binding IsPlayerVisible}"
            RowDefinitions="Auto,*,Auto">
          <Border Padding="24,14" Background="{DynamicResource Brush.Player.Chrome}">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Button Classes="ghost" Command="{Binding BackFromPlayerCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Classes="symbol" Text="arrow_back" />
                  <TextBlock Text="Назад" />
                </StackPanel>
              </Button>
              <StackPanel Grid.Column="1" Margin="18,0" VerticalAlignment="Center">
                <TextBlock Foreground="White" FontWeight="SemiBold" Text="{Binding Player.Title}" />
                <TextBlock Foreground="#B8B8BC" FontSize="11" Text="{Binding Player.StatusText}" />
              </StackPanel>
              <Button Grid.Column="2" Classes="icon-button" Click="FullscreenButton_OnClick">
                <TextBlock Classes="symbol" Text="fullscreen" />
              </Button>
            </Grid>
          </Border>
          <Border Grid.Row="1" Background="Black">
            <ContentControl Content="{Binding Player.MediaPlayer}" />
          </Border>
          <Border Grid.Row="2" Padding="24,14" Background="{DynamicResource Brush.Player.Chrome}">
            <Grid RowDefinitions="Auto,Auto" RowSpacing="10">
              <Slider
                  Maximum="{Binding Player.DurationMs}"
                  Minimum="0"
                  PointerReleased="SeekSlider_OnPointerReleased"
                  Value="{Binding Player.CurrentTimeMs, Mode=OneWay}" />
              <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,Auto,*,Auto,160">
                <Button
                    Padding="12,7"
                    Classes="ghost"
                    Command="{Binding Player.SkipBackCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Classes="symbol" Text="replay_10" />
                    <TextBlock Text="10" />
                  </StackPanel>
                </Button>
                <Button
                    Grid.Column="1"
                    Margin="8,0"
                    Padding="18,7"
                    Classes="primary"
                    Command="{Binding Player.TogglePlaybackCommand}">
                  <TextBlock Classes="symbol filled" Text="play_pause" />
                </Button>
                <Button
                    Grid.Column="2"
                    Padding="12,7"
                    Classes="ghost"
                    Command="{Binding Player.SkipForwardCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Classes="symbol" Text="forward_10" />
                    <TextBlock Text="10" />
                  </StackPanel>
                </Button>
                <TextBlock
                    Grid.Column="4"
                    Margin="16,0"
                    VerticalAlignment="Center"
                    Foreground="#B8B8BC">
                  <TextBlock.Inlines>
                    <Run Text="{Binding Player.CurrentTimeText}" />
                    <Run Text=" / " />
                    <Run Text="{Binding Player.DurationText}" />
                  </TextBlock.Inlines>
                </TextBlock>
                <Slider
                    Grid.Column="5"
                    Maximum="100"
                    Minimum="0"
                    Value="{Binding Player.Volume}" />
              </Grid>
            </Grid>
          </Border>
        </Grid>
      </Grid>

      <!-- Theme-aware tint keeps the top bar legible without blurring the page. -->
      <Grid
          ZIndex="5"
          Height="118"
          VerticalAlignment="Top"
          ClipToBounds="True"
          IsHitTestVisible="False"
          IsVisible="{Binding !IsPlayerVisible}">
        <Border Background="{DynamicResource Brush.TopMask.Tint}">
          <Border.OpacityMask>
            <LinearGradientBrush StartPoint="50%,0%" EndPoint="50%,100%">
              <GradientStop Color="Black" Offset="0" />
              <GradientStop Color="Black" Offset=".35" />
              <GradientStop Color="Transparent" Offset=".8" />
              <GradientStop Color="Transparent" Offset="1" />
            </LinearGradientBrush>
          </Border.OpacityMask>
        </Border>
      </Grid>

      <!-- Large in-app category popup, positioned independently of its trigger. -->
      <Grid
          ZIndex="15"
          ClipToBounds="False"
          IsHitTestVisible="{Binding IsCategoryMenuOpen}"
          IsVisible="{Binding !IsPlayerVisible}">
        <Button
            Classes="popup-dismiss"
            Command="{Binding CloseCategoryMenuCommand}"
            AutomationProperties.Name="Закрыть меню категорий" />
        <Grid ColumnDefinitions="24,*,24" ClipToBounds="False">
          <Border
              x:Name="CategoryMenuPopup"
              Grid.Column="1"
              ZIndex="1"
              MaxWidth="1000"
              Margin="0,90,0,24"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Top"
              Classes="category-mega-menu category-menu-popup"
              Classes.open="{Binding IsCategoryMenuOpen}"
              ClipToBounds="False"
              IsHitTestVisible="{Binding IsCategoryMenuOpen}">
            <ContentControl
                HorizontalContentAlignment="Stretch"
                Content="{Binding OpenCategoryMenu}" />
          </Border>
        </Grid>
      </Grid>

      <!-- In-app profile overlay keeps both opening and closing animations in the visual tree -->
      <Grid
          ZIndex="30"
          IsHitTestVisible="{Binding IsProfilePopupOpen}"
          IsVisible="{Binding !IsPlayerVisible}">
        <Button
            Classes="popup-dismiss"
            Command="{Binding CloseProfilePopupCommand}"
            AutomationProperties.Name="Закрыть меню профиля" />
        <Grid
            Width="{Binding Bounds.Width, ElementName=TopIsland}"
            HorizontalAlignment="Center">
          <Grid
              Width="38"
              Margin="0,0,7,0"
              HorizontalAlignment="Right">
            <Border
                x:Name="ProfilePopup"
                ZIndex="1"
                Width="220"
                Margin="0,92,0,0"
                Padding="8"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Classes="profile-popup"
                Classes.open="{Binding IsProfilePopupOpen}"
                IsHitTestVisible="{Binding IsProfilePopupOpen}">
            <StackPanel Spacing="7">
              <Border Padding="8" Classes="profile-header-card">
                <StackPanel
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                  <Border
                      Width="34"
                      Height="34"
                      Background="{DynamicResource Brush.TopBar.Accent.Soft}"
                      CornerRadius="17"
                      ClipToBounds="True">
                    <Grid>
                      <TextBlock
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Foreground="{DynamicResource Brush.TopBar.Accent}"
                          FontSize="11"
                          FontWeight="Bold"
                          Text="{Binding ProfileInitials}" />
                      <Image Source="{Binding ProfileImageSource^}" Stretch="UniformToFill" />
                    </Grid>
                  </Border>
                  <StackPanel
                      MaxWidth="150"
                      VerticalAlignment="Center"
                      Spacing="1">
                    <TextBlock
                        FontFamily="{StaticResource Font.Body}"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource Brush.Text.Primary}"
                        Text="{Binding ProfileName}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Classes="muted"
                        FontFamily="{StaticResource Font.Body}"
                        FontSize="10"
                        Text="{Binding ProfileEmail}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        IsVisible="{Binding IsPremium}"
                        Foreground="{DynamicResource Brush.TopBar.Accent}"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Text="Premium" />
                  </StackPanel>
                </StackPanel>
              </Border>

              <StackPanel Spacing="3">
                <Button
                    Classes="popup-nav"
                    Classes.active="{Binding IsLibraryVisible}"
                    Command="{Binding ShowLibraryCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock
                        Classes="symbol"
                        Classes.filled="{Binding IsLibraryVisible}"
                        FontSize="17"
                        Text="video_library" />
                    <TextBlock VerticalAlignment="Center" Text="Библиотека" />
                  </StackPanel>
                </Button>
                <Button
                    Classes="popup-nav"
                    Classes.active="{Binding IsSettingsVisible}"
                    Command="{Binding OpenSettingsCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock
                        Classes="symbol"
                        Classes.filled="{Binding IsSettingsVisible}"
                        FontSize="17"
                        Text="settings" />
                    <TextBlock VerticalAlignment="Center" Text="Настройки" />
                  </StackPanel>
                </Button>
                <Button
                    Classes="popup-nav logout"
                    Command="{Binding LogoutCommand}"
                    AutomationProperties.Name="Выйти из аккаунта">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="symbol" FontSize="17" Text="logout" />
                    <TextBlock VerticalAlignment="Center" Text="Выйти" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </StackPanel>
            </Border>
          </Grid>
        </Grid>
      </Grid>
    </Grid>

    <!-- Startup and mandatory authentication -->
    <Grid
        x:Name="StartupOverlay"
        Classes="startup-overlay"
        Classes.visible="{Binding IsStartupVisible}"
        IsVisible="{Binding IsStartupPresented}"
        Background="{DynamicResource Brush.App.Background}"
        RowDefinitions="*,Auto">
      <StackPanel
          x:Name="StartupWizardContent"
          Grid.Row="0"
          Width="560"
          Margin="0,0,0,30"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Classes="startup-wizard-content"
          Classes.visible="{Binding !IsStartupLoading}"
          IsVisible="{Binding !IsStartupLoading}"
          IsHitTestVisible="{Binding !IsStartupLoading}">
        <Carousel
            x:Name="StartupWizardCarousel"
            Height="460"
            IsSwipeEnabled="False"
            SelectedIndex="{Binding StartupWizardStep}">
          <Carousel.PageTransition>
            <transitions:SoftSlideFadeTransition />
          </Carousel.PageTransition>

          <Grid x:Name="LoginWizardPage">
            <StackPanel
                Width="440"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Classes="login-dismissable"
                Classes.dismissed="{Binding IsLoginSuccessTransition}"
                Spacing="26">
            <Grid
                x:Name="LoginBrandComposition"
                Width="260"
                Height="78"
                Margin="0,0,0,4"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsHitTestVisible="False">
              <StackPanel
                  Classes="login-connection-dots"
                  Classes.visible="{Binding AreLoginDotsVisible}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Orientation="Horizontal"
                  Spacing="7">
                <Border Classes="connection-dot first" />
                <Border Classes="connection-dot second" />
                <Border Classes="connection-dot third" />
              </StackPanel>
              <Image
                  Width="70"
                  Height="70"
                  HorizontalAlignment="Center"
                  Classes="login-rezka-logo"
                  Classes.shifted="{Binding IsLoginLogoShifted}"
                  RenderOptions.BitmapInterpolationMode="HighQuality"
                  Source="avares://Rezui/Assets/hdrezka.png"
                  Stretch="Uniform" />
            </Grid>

            <StackPanel HorizontalAlignment="Center" Spacing="5">
              <TextBlock
                  HorizontalAlignment="Center"
                  Classes="h1"
                  Text="{Binding StartupTitle}"
                  TextAlignment="Center" />
              <TextBlock
                  MaxWidth="390"
                  HorizontalAlignment="Center"
                  Classes="muted"
                  Text="{Binding StartupMessage}"
                  TextAlignment="Center"
                  TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel IsVisible="{Binding IsStartupAuthenticationRequired}" Spacing="15">
              <TextBox
                  x:Name="LoginEmailInput"
                  Classes="login-input"
                  PlaceholderText="Электронная почта"
                  Text="{Binding Login}"
                  VerticalContentAlignment="Center">
                <TextBox.InnerLeftContent>
                  <TextBlock Classes="symbol login-field-icon" Text="mail" />
                </TextBox.InnerLeftContent>
              </TextBox>
              <TextBox
                  x:Name="LoginPasswordInput"
                  Classes="login-input"
                  PasswordChar="●"
                  PlaceholderText="Пароль"
                  Text="{Binding Password}"
                  VerticalContentAlignment="Center">
                <TextBox.InnerLeftContent>
                  <TextBlock Classes="symbol login-field-icon" Text="lock" />
                </TextBox.InnerLeftContent>
                <TextBox.KeyBindings>
                  <KeyBinding Gesture="Enter" Command="{Binding LoginCommand}" />
                </TextBox.KeyBindings>
              </TextBox>
              <Button
                  x:Name="LoginSubmitButton"
                  HorizontalAlignment="Stretch"
                  Classes="login-primary"
                  Classes.running="{Binding IsLoginRunning}"
                  Command="{Binding LoginCommand}"
                  IsEnabled="{Binding CanLogin}">
                <Grid
                    MinWidth="92"
                    Height="24"
                    Classes="login-button-content"
                    Classes.running="{Binding IsLoginRunning}">
                  <StackPanel
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Classes="login-button-idle"
                      Orientation="Horizontal">
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource Brush.Text.OnContrast}"
                        Text="Войти" />
                  </StackPanel>
                  <StackPanel
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"
                      Classes="login-button-busy"
                      Orientation="Horizontal"
                      Spacing="8">
                    <TextBlock
                        VerticalAlignment="Center"
                        Classes="symbol login-spinner"
                        Foreground="{DynamicResource Brush.Text.OnContrast}"
                        Text="progress_activity">
                      <TextBlock.RenderTransform>
                        <RotateTransform />
                      </TextBlock.RenderTransform>
                    </TextBlock>
                    <TextBlock
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource Brush.Text.OnContrast}"
                        Text="Вхожу" />
                  </StackPanel>
                </Grid>
              </Button>
              <TextBlock
                  MinHeight="32"
                  Classes="login-status"
                  Classes.visible="{Binding IsLoginStatusVisible}"
                  Foreground="{StaticResource Brush.Danger}"
                  FontSize="12"
                  Text="{Binding LoginStatusMessage}"
                  TextAlignment="Center"
                  TextWrapping="Wrap" />
            </StackPanel>
            </StackPanel>
          </Grid>

          <Grid x:Name="MirrorWizardPage">
            <StackPanel
                Width="440"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="22">
            <StackPanel HorizontalAlignment="Center" Spacing="5">
              <TextBlock
                  HorizontalAlignment="Center"
                  Classes="h1"
                  Text="Подключение"
                  TextAlignment="Center" />
              <TextBlock
                  MaxWidth="390"
                  HorizontalAlignment="Center"
                  Classes="muted"
                  Text="Выберите зеркало с подходящей задержкой ответа"
                  TextAlignment="Center"
                  TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="0">
              <Border Classes="mirror-list">
                <StackPanel Spacing="0">
                  <Button
                      Classes="mirror-option"
                      Classes.active="{Binding IsAutoMirrorSelection}"
                      Command="{Binding SelectAutoMirrorCommand}">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                      <TextBlock
                          VerticalAlignment="Center"
                          FontWeight="Normal"
                          Text="Автовыбор" />
                      <TextBlock
                          Grid.Column="1"
                          VerticalAlignment="Center"
                          Classes="muted"
                          FontSize="12"
                          Text="минимальный пинг" />
                    </Grid>
                  </Button>

                  <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding MirrorStatuses}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:MirrorStatusItem">
                          <Button
                              Margin="0"
                              Classes="mirror-option"
                              Classes.active="{Binding IsSelected}"
                              Classes.unavailable="{Binding !IsAvailable}"
                              Command="{Binding #RootWindow.((vm:MainWindowViewModel)DataContext).SelectMirrorCommand}"
                              CommandParameter="{Binding}"
                              IsEnabled="{Binding IsAvailable}">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                              <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontWeight="Normal"
                                    Text="{Binding DisplayName}" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Classes="muted"
                                    FontSize="11"
                                    IsVisible="{Binding IsCustom}"
                                    Text="своё" />
                              </StackPanel>
                              <TextBlock
                                  Grid.Column="1"
                                  VerticalAlignment="Center"
                                  Classes="mirror-latency"
                                  Classes.unavailable="{Binding !IsAvailable}"
                                  Text="{Binding StatusText}" />
                            </Grid>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </StackPanel>
              </Border>

              <StackPanel Margin="0,10,0,0" Spacing="8">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBox
                      Classes="login-input mirror-custom-input"
                      PlaceholderText="https://example.com"
                      Text="{Binding CustomMirror}"
                      VerticalContentAlignment="Center">
                    <TextBox.KeyBindings>
                      <KeyBinding Gesture="Enter" Command="{Binding UseCustomMirrorCommand}" />
                    </TextBox.KeyBindings>
                  </TextBox>
                  <Button
                      x:Name="MirrorUseButton"
                      Grid.Column="1"
                      Classes="mirror-use"
                      Classes.running="{Binding IsUsingCustomMirror}"
                      Command="{Binding UseCustomMirrorCommand}"
                      IsEnabled="{Binding !IsUsingCustomMirror}">
                    <Grid
                        MinWidth="104"
                        Height="24"
                        Classes="login-button-content"
                        Classes.running="{Binding IsUsingCustomMirror}">
                      <StackPanel
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Classes="login-button-idle"
                          Orientation="Horizontal">
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource Brush.Text.OnContrast}"
                            Text="Использовать" />
                      </StackPanel>
                      <StackPanel
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"
                          Classes="login-button-busy"
                          Orientation="Horizontal"
                          Spacing="8">
                        <TextBlock
                            VerticalAlignment="Center"
                            Classes="symbol login-spinner"
                            Foreground="{DynamicResource Brush.Text.OnContrast}"
                            Text="progress_activity">
                          <TextBlock.RenderTransform>
                            <RotateTransform />
                          </TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource Brush.Text.OnContrast}"
                            Text="Проверяю" />
                      </StackPanel>
                    </Grid>
                  </Button>
                </Grid>
                <TextBlock
                    MinHeight="16"
                    Classes="mirror-status"
                    Classes.visible="{Binding IsMirrorStatusVisible}"
                    Foreground="{DynamicResource Brush.Text.Secondary}"
                    FontSize="11"
                    Text="{Binding MirrorStatusMessage}"
                    TextWrapping="Wrap" />
              </StackPanel>
            </StackPanel>
            </StackPanel>
          </Grid>
        </Carousel>
      </StackPanel>

      <Carousel
          Grid.Row="1"
          Width="320"
          Margin="0,0,0,24"
          HorizontalAlignment="Center"
          Classes="startup-wizard-content"
          Classes.visible="{Binding !IsStartupLoading}"
          IsVisible="{Binding !IsStartupLoading}"
          IsHitTestVisible="{Binding !IsStartupLoading}"
          IsSwipeEnabled="False"
          SelectedIndex="{Binding StartupWizardStep}">
        <Carousel.PageTransition>
          <CrossFade Duration="0:0:0.16">
            <CrossFade.FadeInEasing>
              <CubicEaseOut />
            </CrossFade.FadeInEasing>
            <CrossFade.FadeOutEasing>
              <CubicEaseOut />
            </CrossFade.FadeOutEasing>
          </CrossFade>
        </Carousel.PageTransition>

        <Grid>
          <Button
              x:Name="MirrorAnchorButton"
              HorizontalAlignment="Center"
              Classes="mirror-anchor login-footer-item"
              Classes.dismissed="{Binding IsLoginSuccessTransition}"
              Command="{Binding OpenMirrorWizardCommand}"
              IsEnabled="{Binding IsMirrorSelectorEnabled}">
            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
              <TextBlock
                  VerticalAlignment="Center"
                  Classes="symbol connection-spinner"
                  IsVisible="{Binding IsMirrorCheckRunning}"
                  Text="progress_activity" />
              <TextBlock
                  VerticalAlignment="Center"
                  Classes="symbol"
                  IsVisible="{Binding !IsMirrorCheckRunning}"
                  Text="language" />
              <TextBlock
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Text="{Binding MirrorSelectorLabel}" />
            </Grid>
          </Button>
        </Grid>

        <Grid>
          <Button
              HorizontalAlignment="Center"
              Classes="mirror-anchor login-footer-item"
              Classes.dismissed="{Binding IsLoginSuccessTransition}"
              Command="{Binding CloseMirrorWizardCommand}">
            <Grid ColumnDefinitions="Auto,Auto" ColumnSpacing="8">
              <TextBlock
                  VerticalAlignment="Center"
                  Classes="symbol"
                  Text="arrow_back" />
              <TextBlock
                  Grid.Column="1"
                  VerticalAlignment="Center"
                  Text="Вернуться ко входу" />
            </Grid>
          </Button>
        </Grid>
      </Carousel>

      <Image
          x:Name="LoginFoxLogo"
          Grid.RowSpan="2"
          Width="78"
          Height="78"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          IsHitTestVisible="False"
          Classes="login-fox-logo"
          Classes.centered="{Binding IsLoginFoxCentered}"
          Classes.motion-suppressed="{Binding IsLoginFoxMotionSuppressed}"
          Classes.visible="{Binding IsLoginFoxVisible}"
          RenderOptions.BitmapInterpolationMode="HighQuality"
          Source="avares://Rezui/Assets/rezui.png"
          Stretch="Uniform" />

      <Grid
          x:Name="StartupLoadingContent"
          Grid.RowSpan="2"
          Classes="startup-loading-content"
          IsVisible="{Binding IsStartupLoading}"
          IsHitTestVisible="{Binding IsStartupLoading}">
        <Image
            x:Name="StartupLoadingLogo"
            Width="78"
            Height="78"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Classes="startup-loading-logo"
            Classes.handoff="{Binding IsLoginSuccessTransition}"
            RenderOptions.BitmapInterpolationMode="HighQuality"
            Source="avares://Rezui/Assets/rezui.png"
            Stretch="Uniform" />
        <TextBlock
            x:Name="StartupSpinner"
            Margin="0,132,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Classes="symbol login-spinner startup-spinner"
            Classes.visible="{Binding IsStartupLoading}"
            FontSize="30"
            Foreground="{DynamicResource Brush.Text.Secondary}"
            Text="progress_activity">
          <TextBlock.RenderTransform>
            <RotateTransform />
          </TextBlock.RenderTransform>
        </TextBlock>
      </Grid>
    </Grid>

    <!-- Playback options -->
    <Border
        Background="{DynamicResource Brush.Scrim}"
        IsVisible="{Binding IsPlaybackOptionsOpen}">
      <Border
          Width="520"
          Padding="28"
          HorizontalAlignment="Center"
          VerticalAlignment="Center"
          Classes="dialog">
        <StackPanel Spacing="18">
          <StackPanel Spacing="5">
            <TextBlock Classes="h2" Text="Запустить просмотр" />
            <TextBlock Classes="muted" Text="Выберите качество и субтитры" />
          </StackPanel>
          <StackPanel Spacing="7">
            <TextBlock Classes="eyebrow" Text="КАЧЕСТВО" />
            <ComboBox ItemsSource="{Binding Qualities}" SelectedItem="{Binding SelectedQuality}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="models:QualityItem">
                  <TextBlock Text="{Binding DisplayName}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <StackPanel Spacing="7">
            <TextBlock Classes="eyebrow" Text="СУБТИТРЫ" />
            <ComboBox ItemsSource="{Binding Subtitles}" SelectedItem="{Binding SelectedSubtitle}">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="models:SubtitleItem">
                  <TextBlock Text="{Binding Title}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
          <TextBlock
              Foreground="{StaticResource Brush.Danger}"
              FontSize="12"
              Text="{Binding StatusMessage}"
              TextWrapping="Wrap" />
          <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="10">
            <Button Classes="ghost" Command="{Binding ClosePlaybackOptionsCommand}" Content="Отмена" />
            <Button Classes="primary" Command="{Binding StartPlaybackCommand}">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Classes="symbol filled" Text="play_arrow" />
                <TextBlock Text="Смотреть" />
              </StackPanel>
            </Button>
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <!-- Non-blocking operation status -->
    <Border
        Margin="0,0,24,24"
        Padding="16,12"
        HorizontalAlignment="Right"
        VerticalAlignment="Bottom"
        Classes="island"
        IsVisible="{Binding IsBusy}">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <ProgressBar
            Width="90"
            VerticalAlignment="Center"
            IsIndeterminate="True" />
        <TextBlock
            MaxWidth="320"
            VerticalAlignment="Center"
            Text="{Binding StatusMessage}"
            TextTrimming="CharacterEllipsis" />
        <Button
            Padding="9,5"
            Command="{Binding CancelOperationCommand}"
            Content="Отмена" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
