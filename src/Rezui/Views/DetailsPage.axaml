<UserControl
    x:Class="Rezui.Views.DetailsPage"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="clr-namespace:Rezui.Models"
    xmlns:vm="clr-namespace:Rezui.ViewModels"
    x:DataType="vm:MainWindowViewModel">

  <ScrollViewer
      x:Name="DetailsScrollViewer"
      Classes="smooth-scroll details-page"
      Classes.detailed-hero="{Binding UseDetailedHeroEntrance}"
      Classes.entering="{Binding IsDetailsEntering}"
      Classes.leaving="{Binding IsDetailsLeaving}"
      Classes.loading="{Binding IsDetailsContentLoading}"
      BringIntoViewOnFocusChange="False"
      HorizontalScrollBarVisibility="Disabled"
      IsHitTestVisible="{Binding !IsDetailsContentLoading}"
      IsVisible="{Binding IsDetailsVisible}">
    <StackPanel Spacing="0">
      <Grid Height="620" ClipToBounds="False">
        <Border
            Classes="details-hero-shadow"
            Classes.visible="{Binding IsDetailsHeroSurfaceVisible}"
            BoxShadow="0 22 54 0 #5C000000"
            IsHitTestVisible="False">
          <Border.CacheMode>
            <BitmapCache RenderAtScale="0.75" />
          </Border.CacheMode>
        </Border>
        <Border Classes="details-hero">
          <Border ClipToBounds="True">
            <Grid>
              <Border
                  Classes="details-hero-base"
                  Classes.visible="{Binding IsDetailsHeroSurfaceVisible}"
                  Background="#FF111114" />
              <Grid
                  Classes="details-hero-backdrop"
                  Classes.ready="{Binding IsDetailsHeroBackgroundReady}">
                <Image
                    Classes="details-hero-background"
                    IsVisible="{Binding IsDetailsHeroPrimaryImageVisible}"
                    Margin="-56"
                    RenderTransformOrigin="50%,50%"
                    Source="{Binding DetailsImageSource}"
                    Stretch="UniformToFill">
                  <!-- No BitmapCache here: these images swap on every title
                       navigation, and a cached layer would keep showing the
                       previous title's backdrop until the new one renders. -->
                  <Image.Effect>
                    <BlurEffect Radius="44" />
                  </Image.Effect>
                  <Image.RenderTransform>
                    <ScaleTransform />
                  </Image.RenderTransform>
                </Image>
                <Image
                    Classes="details-hero-background details-hero-image-upgrade"
                    Classes.ready="{Binding IsDetailsHeroImageUpgradeReady}"
                    Margin="-56"
                    RenderTransformOrigin="50%,50%"
                    Source="{Binding DetailsHeroUpgradeImageSource}"
                    Stretch="UniformToFill">
                  <Image.Effect>
                    <BlurEffect Radius="44" />
                  </Image.Effect>
                  <Image.RenderTransform>
                    <ScaleTransform />
                  </Image.RenderTransform>
                </Image>
                <Border
                    Classes="details-hero-scrim"
                    Background="#A8111114"
                    Opacity="1" />
              </Grid>

              <StackPanel
                  Width="720"
                  Margin="28,94,28,28"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Classes="details-hero-content"
                  Classes.visible="{Binding IsDetailsHeroContentVisible}"
                  Classes.move-ready="{Binding IsDetailsHeroMetadataReady}"
                  Spacing="7">
                <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Classes="details-hero-heading"
                    Spacing="10">
                  <Border
                      Width="148"
                      Height="212"
                      HorizontalAlignment="Center"
                      Background="#40111114"
                      BoxShadow="0 12 34 0 #66000000"
                      Classes="details-hero-poster"
                      CornerRadius="15"
                      ClipToBounds="True"
                      Opacity="1">
                    <Border.RenderTransform>
                      <TransformGroup>
                        <ScaleTransform />
                        <TranslateTransform />
                      </TransformGroup>
                    </Border.RenderTransform>
                    <Grid>
                      <Image
                          IsVisible="{Binding IsDetailsHeroPrimaryImageVisible}"
                          Source="{Binding DetailsImageSource}"
                          Stretch="UniformToFill" />
                      <Image
                          Classes="details-hero-poster-upgrade"
                          Classes.ready="{Binding IsDetailsHeroImageUpgradeReady}"
                          Source="{Binding DetailsHeroUpgradeImageSource}"
                          Stretch="UniformToFill" />
                    </Grid>
                  </Border>
                  <TextBlock
                      Width="720"
                      HorizontalAlignment="Center"
                      Classes="details-hero-title"
                      Foreground="White"
                      FontSize="{Binding DetailsTitleFontSize}"
                      FontWeight="SemiBold"
                      LineHeight="{Binding DetailsTitleLineHeight}"
                      MaxLines="3"
                      Opacity="1"
                      Text="{Binding DetailsTitle}"
                      TextAlignment="Center"
                      TextTrimming="CharacterEllipsis"
                      TextWrapping="Wrap">
                    <TextBlock.RenderTransform><TranslateTransform /></TextBlock.RenderTransform>
                  </TextBlock>
                </StackPanel>
                <StackPanel
                    Width="720"
                    HorizontalAlignment="Center"
                    Classes="details-hero-metadata"
                    Classes.visible="{Binding IsDetailsHeroMetadataVisible}"
                    IsHitTestVisible="{Binding IsDetailsHeroMetadataVisible}"
                    Spacing="7">
                  <Grid Width="720" Height="36" HorizontalAlignment="Center">
                    <TextBlock
                        Width="720"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Classes="details-hero-original"
                        Foreground="#AFFFFFFF"
                        FontSize="13"
                        LineHeight="18"
                        MaxLines="2"
                        Opacity="1"
                        Text="{Binding DetailsOriginalTitle}"
                        TextAlignment="Center"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap">
                      <TextBlock.RenderTransform><TranslateTransform /></TextBlock.RenderTransform>
                    </TextBlock>
                  </Grid>
                  <WrapPanel
                      Height="18"
                      HorizontalAlignment="Center"
                      Classes="details-hero-meta"
                      Opacity="1">
                    <WrapPanel.RenderTransform><TranslateTransform /></WrapPanel.RenderTransform>
                    <TextBlock
                        Margin="7,0"
                        Foreground="White"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Text="{Binding DetailsRating}" />
                    <TextBlock
                        Margin="7,0"
                        Foreground="#CFFFFFFF"
                        FontSize="12"
                        Text="{Binding DetailsMeta}" />
                  </WrapPanel>
                  <Border
                      Width="188"
                      Height="46"
                      Margin="0,18,0,0"
                      HorizontalAlignment="Center"
                      Classes="details-hero-action"
                      Opacity="1">
                    <Border.RenderTransform>
                      <TransformGroup>
                        <ScaleTransform />
                        <TranslateTransform />
                      </TransformGroup>
                    </Border.RenderTransform>
                    <Button
                        Width="188"
                        Height="46"
                        Classes="details-watch"
                        Classes.available="{Binding CanWatchDetails}"
                        Command="{Binding OpenPlayerCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock
                            VerticalAlignment="Center"
                            Classes="symbol filled"
                            FontSize="21"
                            Text="play_arrow" />
                        <TextBlock
                            VerticalAlignment="Center"
                            LineHeight="21"
                            Text="Смотреть" />
                      </StackPanel>
                    </Button>
                  </Border>
                </StackPanel>
              </StackPanel>
            </Grid>
          </Border>
        </Border>
      </Grid>

      <Grid
          MaxWidth="1120"
          Margin="28,28,28,64"
          HorizontalAlignment="Stretch"
          Classes="details-skeleton"
          ColumnDefinitions="1.5*,*"
          ColumnSpacing="22"
          RowDefinitions="Auto,Auto"
          IsVisible="{Binding IsDetailsContentLoading}">
        <Border Height="220" Padding="24" Classes="details-skeleton-card">
          <StackPanel Spacing="15">
            <Border Width="176" Height="24" HorizontalAlignment="Left" Classes="details-skeleton-block" />
            <Border Height="14" Classes="details-skeleton-block second" />
            <Border Height="14" Classes="details-skeleton-block third" />
            <Grid ColumnDefinitions="4*,*">
              <Border Height="14" Classes="details-skeleton-block" />
            </Grid>
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Height="220" Padding="24" Classes="details-skeleton-card">
          <StackPanel Spacing="15">
            <Border Width="142" Height="24" HorizontalAlignment="Left" Classes="details-skeleton-block second" />
            <Grid ColumnDefinitions="112,*" ColumnSpacing="18">
              <Border Height="12" Classes="details-skeleton-block third" />
              <Border Grid.Column="1" Height="12" Classes="details-skeleton-block" />
            </Grid>
            <Grid ColumnDefinitions="112,*" ColumnSpacing="18">
              <Border Height="12" Classes="details-skeleton-block second" />
              <Border Grid.Column="1" Height="12" Classes="details-skeleton-block third" />
            </Grid>
            <Grid ColumnDefinitions="112,*" ColumnSpacing="18">
              <Border Height="12" Classes="details-skeleton-block" />
              <Border Grid.Column="1" Height="12" Classes="details-skeleton-block second" />
            </Grid>
          </StackPanel>
        </Border>
        <TextBlock
            Grid.Row="1"
            Grid.ColumnSpan="2"
            Margin="0,16,0,0"
            HorizontalAlignment="Center"
            Classes="muted"
            FontSize="12"
            Text="{Binding DetailsLoadingStatus}" />
      </Grid>

      <Border
          MaxWidth="1120"
          Margin="28,28,28,64"
          Padding="32"
          HorizontalAlignment="Stretch"
          Classes="card details-card details-load-error"
          IsVisible="{Binding IsDetailsContentLoadFailed}">
        <StackPanel HorizontalAlignment="Center" Spacing="10">
          <TextBlock
              HorizontalAlignment="Center"
              Classes="symbol"
              Foreground="{DynamicResource Brush.Text.Secondary}"
              FontSize="30"
              Text="cloud_off" />
          <TextBlock
              HorizontalAlignment="Center"
              Classes="h2"
              Text="Не удалось загрузить данные тайтла" />
          <TextBlock
              MaxWidth="620"
              HorizontalAlignment="Center"
              Classes="muted"
              Text="{Binding DetailsContentError}"
              TextAlignment="Center"
              TextWrapping="Wrap" />
          <Button
              Margin="0,8,0,0"
              HorizontalAlignment="Center"
              Classes="login-primary details-retry"
              Command="{Binding RetryDetailsContentCommand}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" Spacing="7">
              <TextBlock Classes="symbol" FontSize="18" Text="refresh" />
              <TextBlock Text="Попробовать снова" />
            </StackPanel>
          </Button>
        </StackPanel>
      </Border>

      <StackPanel
          MaxWidth="1120"
          Margin="28,28,28,64"
          HorizontalAlignment="Stretch"
          Classes="details-body"
          IsVisible="{Binding IsDetailsContentReady}"
          Opacity="1"
          Spacing="32">
        <StackPanel.RenderTransform><TranslateTransform /></StackPanel.RenderTransform>
        <Grid ColumnDefinitions="1.5*,*" ColumnSpacing="22">
          <Border Padding="24" Classes="card details-card">
            <StackPanel Spacing="12">
              <TextBlock Classes="h2" Text="Описание" />
              <TextBlock
                  FontSize="15"
                  LineHeight="23"
                  Text="{Binding DetailsDescription}"
                  TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border Grid.Column="1" Padding="24" Classes="card details-card">
            <StackPanel Spacing="12">
              <TextBlock Classes="h2" Text="Подробности" />
              <ItemsControl ItemsSource="{Binding DetailsFacts}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="models:DetailFactItem">
                    <Grid Margin="0,0,0,10" ColumnDefinitions="120,*">
                      <TextBlock Classes="muted" FontSize="12" Text="{Binding Label}" />
                      <TextBlock
                          Grid.Column="1"
                          FontSize="12"
                          IsVisible="{Binding HasPlainValue}"
                          Text="{Binding Value}"
                          TextWrapping="Wrap" />
                      <ItemsControl
                          Grid.Column="1"
                          IsVisible="{Binding HasCountries}"
                          ItemsSource="{Binding Countries}">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="models:CountryFlagItem">
                            <StackPanel
                                Margin="0,0,7,4"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="5">
                              <Border
                                  Width="18"
                                  Height="12"
                                  VerticalAlignment="Center"
                                  CornerRadius="2"
                                  ClipToBounds="True"
                                  IsVisible="{Binding HasImage}">
                                <Image Source="{Binding ImageSource}" Stretch="UniformToFill" />
                              </Border>
                              <TextBlock
                                  VerticalAlignment="Center"
                                  FontSize="12"
                                  Text="{Binding Name}" />
                              <TextBlock
                                  Margin="-3,0,0,0"
                                  VerticalAlignment="Center"
                                  FontSize="12"
                                  IsVisible="{Binding HasTrailingSeparator}"
                                  Text="," />
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                      <Path
                          Grid.Column="1"
                          Width="22"
                          Height="22"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          AutomationProperties.Name="{Binding Value}"
                          Data="{Binding AgeIcon}"
                          Fill="{DynamicResource Brush.Text.Primary}"
                          IsVisible="{Binding HasAgeIcon}"
                          Stretch="Uniform"
                          ToolTip.Tip="{Binding Value}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>
        </Grid>

        <StackPanel IsVisible="{Binding DetailsExternalRatings.Count}" Spacing="12">
          <TextBlock Classes="h2" Text="Рейтинги" />
          <ItemsControl
              Margin="-18,-18,-18,-28"
              ItemsSource="{Binding DetailsExternalRatings}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><WrapPanel Margin="18,18,18,28" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:ExternalRatingItem">
                <Border
                    Width="220"
                    Height="104"
                    Margin="0,0,12,10"
                    Padding="14"
                    Classes="rating-card"
                    Classes.imdb="{Binding IsImdb}"
                    Classes.kinopoisk="{Binding IsKinopoisk}"
                    Classes.worldart="{Binding IsWorldArt}"
                    Classes.other="{Binding IsOther}">
                  <Grid ColumnDefinitions="64,*">
                    <Border
                        Width="64"
                        Height="64"
                        CornerRadius="13"
                        ClipToBounds="True">
                      <Grid>
                        <Image
                            IsVisible="{Binding IsImdb}"
                            Source="avares://Rezui/Assets/imdb.png"
                            Stretch="UniformToFill" />
                        <Image
                            IsVisible="{Binding IsKinopoisk}"
                            Source="avares://Rezui/Assets/kinopoisk.png"
                            Stretch="UniformToFill" />
                        <Image
                            IsVisible="{Binding IsWorldArt}"
                            Source="avares://Rezui/Assets/worldart.png"
                            Stretch="UniformToFill" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="SemiBold"
                            IsVisible="{Binding IsOther}"
                            Text="{Binding Source}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                      </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="13,0,6,0" VerticalAlignment="Center" Spacing="1">
                      <TextBlock Classes="rating-source" FontSize="11" Text="{Binding Source}" />
                      <TextBlock Classes="rating-value" FontSize="27" FontWeight="SemiBold" Text="{Binding Value}" />
                      <TextBlock Classes="rating-votes" FontSize="10" Text="{Binding Votes}" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel IsVisible="{Binding DetailsDirectors.Count}" Spacing="12">
          <TextBlock Classes="h2" Text="Режиссёры" />
          <ItemsControl
              x:Name="DetailsDirectorsList"
              ClipToBounds="False"
              ItemsSource="{Binding DetailsDirectors}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:PersonCardItem">
                <Border Width="170" Margin="0,0,12,10" Padding="10" Classes="card details-card">
                  <Grid ColumnDefinitions="44,*">
                    <Border Width="44" Height="44" CornerRadius="22" ClipToBounds="True" Background="{DynamicResource Brush.Surface.Secondary}">
                      <Grid>
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Classes="symbol filled"
                            FontSize="25"
                            Foreground="{DynamicResource Brush.Text.Secondary}"
                            Text="person" />
                        <Image Source="{Binding ImageSource.Value^}" Stretch="UniformToFill" />
                      </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                      <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="muted" FontSize="10" Text="{Binding Job}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel IsVisible="{Binding DetailsCast.Count}" Spacing="12">
          <TextBlock Classes="h2" Text="В ролях" />
          <ItemsControl
              x:Name="DetailsCastList"
              ClipToBounds="False"
              ItemsSource="{Binding DetailsCast}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:PersonCardItem">
                <Border Width="170" Margin="0,0,12,10" Padding="10" Classes="card details-card">
                  <Grid ColumnDefinitions="44,*">
                    <Border Width="44" Height="44" CornerRadius="22" ClipToBounds="True" Background="{DynamicResource Brush.Surface.Secondary}">
                      <Grid>
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Classes="symbol filled"
                            FontSize="25"
                            Foreground="{DynamicResource Brush.Text.Secondary}"
                            Text="person" />
                        <Image Source="{Binding ImageSource.Value^}" Stretch="UniformToFill" />
                      </Grid>
                    </Border>
                    <StackPanel Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center">
                      <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                      <TextBlock Classes="muted" FontSize="10" Text="{Binding Job}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel IsVisible="{Binding DetailsSchedule.Count}" Spacing="12">
          <TextBlock Classes="h2" Text="Расписание серий" />
          <ItemsControl
              x:Name="DetailsScheduleList"
              ClipToBounds="False"
              ItemsSource="{Binding DetailsSchedule}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:ScheduleCardItem">
                <Border Width="250" Margin="0,0,12,10" Padding="14" Classes="card details-card">
                  <StackPanel Spacing="4">
                    <TextBlock FontSize="11" FontWeight="SemiBold" Text="{Binding EpisodeLabel}" />
                    <TextBlock FontSize="12" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="muted" FontSize="10" Text="{Binding DateLabel}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <ItemsControl
            IsVisible="{Binding HasDetailGroups}"
            ItemsSource="{Binding DetailsGroups}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid
                  Columns="{Binding DetailsGroupColumnCount}"
                  ColumnSpacing="16" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="models:DetailGroupCardItem">
              <Border Padding="20" Classes="card details-card">
                <StackPanel Spacing="12">
                  <TextBlock Classes="h2" Text="{Binding Title}" />
                  <ItemsControl ItemsSource="{Binding Columns}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <UniformGrid
                            Columns="{Binding ColumnCount}"
                            ColumnSpacing="20" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="models:DetailGroupColumnItem">
                        <ItemsControl ItemsSource="{Binding Items}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <TextBlock
                                  Margin="0,0,0,7"
                                  FontSize="12"
                                  Text="{Binding}"
                                  TextWrapping="Wrap" />
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel IsVisible="{Binding DetailsRecommendations.Count}" Spacing="14">
          <TextBlock Classes="h2" Text="Вам также понравится" />
          <ItemsControl
              x:Name="DetailsRecommendationsList"
              ClipToBounds="False"
              ItemsSource="{Binding DetailsRecommendations}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="models:MediaCardItem">
                <Button
                    Width="174"
                    Margin="0,0,16,20"
                    Classes="media-card details-media-card"
                    Command="{Binding OpenCommand}">
                  <StackPanel Spacing="10">
                    <Border
                        Height="246"
                        Background="{DynamicResource Brush.Surface.Secondary}"
                        CornerRadius="16"
                        ClipToBounds="True">
                      <Grid>
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Classes="symbol"
                            Foreground="{DynamicResource Brush.Text.Secondary}"
                            Text="movie" />
                        <Image Source="{Binding ImageSource.Value^}" Stretch="UniformToFill" />
                        <Border
                            Padding="9,5"
                            Margin="10"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Background="#CC111014"
                            CornerRadius="8">
                          <TextBlock
                              Foreground="White"
                              FontSize="11"
                              FontWeight="SemiBold"
                              Text="{Binding Category}" />
                        </Border>
                      </Grid>
                    </Border>
                    <TextBlock
                        MaxHeight="44"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Text="{Binding Title}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="h2" Text="Комментарии" />
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                Classes="muted"
                FontSize="15"
                LineHeight="20"
                Text="{Binding DetailsComments.Count, StringFormat='{}{0} загружено'}" />
          </Grid>
          <ItemsControl ItemTemplate="{StaticResource CommentNodeTemplate}" ItemsSource="{Binding DetailsComments}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Spacing="12" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
          <Border
              Padding="24"
              Classes="card details-card"
              IsVisible="{Binding !DetailsComments.Count}">
            <StackPanel HorizontalAlignment="Center" Spacing="7">
              <TextBlock
                  HorizontalAlignment="Center"
                  Classes="symbol"
                  Foreground="{DynamicResource Brush.Text.Secondary}"
                  FontSize="24"
                  Text="forum" />
              <TextBlock Classes="muted" Text="У этого тайтла пока нет комментариев" />
            </StackPanel>
          </Border>
          <Button
              HorizontalAlignment="Center"
              Classes="details-load-more"
              Command="{Binding LoadMoreCommentsCommand}"
              IsEnabled="{Binding CanLoadMoreComments}"
              IsVisible="{Binding CanLoadMoreComments}"
              Content="Показать ещё" />
        </StackPanel>

      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
